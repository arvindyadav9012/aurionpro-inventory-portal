// V40 Live Sync provision: UI/design remains unchanged; only persistence/sync is added.
const LIVE_SYNC_CONFIG={
  apiBase:(window.NMRC_INVENTORY_API_BASE||'/api').replace(/\/$/,''),
  driveBackupUrl:window.NMRC_INVENTORY_DRIVE_BACKUP_URL||'',
  pollMs:Number(window.NMRC_INVENTORY_SYNC_POLL_MS||1500)
};
let liveSyncReady=false,liveSyncBusy=false,liveSyncTimer=null;
let localMutationSeq=0,lastPushedMutationSeq=0;
function recordKey(reportKey,row){return String(row?._recordId||row?._id||row?.id||'')||`${reportKey}|${JSON.stringify(row||{})}`;}
async function liveSyncPull(){if(!LIVE_SYNC_CONFIG.apiBase||liveSyncBusy)return;if(localMutationSeq!==lastPushedMutationSeq)return;liveSyncBusy=true;try{const r=await fetch(LIVE_SYNC_CONFIG.apiBase+'/state?ts='+Date.now(),{cache:'no-store',headers:{'x-aurion-api-key':window.NMRC_INVENTORY_API_KEY||''}});if(!r.ok)return;const j=await r.json();if(j.ok&&j.state&&typeof j.state==='object'){const remote=j.state||{}; const mergedDeleted=[...(state.deletedLocationHistory||[])]; const deletedSeen=new Set(mergedDeleted.map(x=>x._locationId||`${x.employeeId}|${x.datetime}|${x.lat}|${x.lng}`)); (remote.deletedLocationHistory||[]).forEach(x=>{const id=x._locationId||`${x.employeeId}|${x.datetime}|${x.lat}|${x.lng}`;if(!deletedSeen.has(id)){mergedDeleted.push(x);deletedSeen.add(id)}}); state={...state,...remote,deletedLocationHistory:mergedDeleted,records:{...state.records,...(remote.records||{})}}; state.purgedRecordKeys=[...new Set([...(state.purgedRecordKeys||[]),...(remote.purgedRecordKeys||[])])]; state.permanentDeletedRecordKeys=[...new Set([...(state.permanentDeletedRecordKeys||[]),...(remote.permanentDeletedRecordKeys||[])])]; state.deletedStations=[...new Set([...(state.deletedStations||[]),...(remote.deletedStations||[])])]; state.deletedEquipmentMaster=[...new Set([...(state.deletedEquipmentMaster||[]),...(remote.deletedEquipmentMaster||[])])]; state.deletedComponents=[...new Set([...(state.deletedComponents||[]),...(remote.deletedComponents||[])])]; const purged=new Set(state.purgedRecordKeys||[]); Object.keys(state.records||{}).forEach(k=>{state.records[k]=(state.records[k]||[]).filter(r=>!purged.has(recordKey(k,r)))}); const permanentSet=new Set(state.permanentDeletedRecordKeys||[]); state.deletedRecords=(state.deletedRecords||[]).filter(x=>!permanentSet.has(String(x.recordKey||recordKey(x.reportKey||'',x.record)))); state.stations=(state.stations||[]).filter(x=>!(state.deletedStations||[]).includes(String(x))); state.equipmentMaster=(state.equipmentMaster||[]).filter(x=>!(state.deletedEquipmentMaster||[]).includes(`${x?.type||''}|${x?.name||''}|${x?.number||''}`)); state.componentMaster=(state.componentMaster||[]).filter(x=>!(state.deletedComponents||[]).includes(String(x))); let defaultsChanged=false; DEFAULT_STATIONS.forEach(x=>{if(!state.stations.some(v=>String(v).toLowerCase()===x.toLowerCase())&&!state.deletedStations.includes(x)){state.stations.push(x);defaultsChanged=true}}); DEFAULT_EQUIPMENT_NAMES.forEach(x=>{if(!state.equipmentMaster.some(v=>String(v?.name||'').toLowerCase()===x.toLowerCase())&&!state.deletedEquipmentMaster.includes(`AG|${x}|`)){state.equipmentMaster.push({type:'AG',name:x,number:''});defaultsChanged=true}}); if(defaultsChanged){localMutationSeq++;liveSyncPush();} const deletedIds=new Set(mergedDeleted.map(x=>x._locationId||`${x.employeeId}|${x.datetime}|${x.lat}|${x.lng}`)); state.locations=(remote.locations||state.locations||[]).filter(x=>!deletedIds.has(x._locationId||`${x.employeeId}|${x.datetime}|${x.lat}|${x.lng}`));Object.keys(BASE_REPORTS).forEach(k=>state.records[k] ||= []);state.reportDefs ||= {};state.stations ||= [];state.equipmentMaster ||= [];reports=deepClone(BASE_REPORTS);(state.dynamic||[]).forEach(k=>{if(state.reportDefs[k])reports[k]=state.reportDefs[k]});applyStandardFields();if(currentUser&&!isAdmin()&&Array.isArray(state.users)){const centralUser=state.users.find(x=>String(x?.id||'').toLowerCase()===String(currentUser.id||'').toLowerCase());if(centralUser){currentUser={...currentUser,...centralUser,sessionId:currentSessionId,lastLogin:currentUser.lastLogin||centralUser.lastLogin};applyCCRRolePermissions(currentUser);storageSet('aurion_session_v1',JSON.stringify(currentUser));}}localStorage.setItem('aurion_state_v18',JSON.stringify(state));if(currentUser){const hasOpenForm=!!document.querySelector('#reportForm form');renderNav();renderDashboard();if(current==='summary'&&!hasOpenForm)renderReport();else if(current==='location')renderLocation();}}liveSyncReady=true}catch(e){console.warn('Live sync pull failed',e)}finally{liveSyncBusy=false}}
function startLiveSync(){clearInterval(liveSyncTimer);if(!LIVE_SYNC_CONFIG.apiBase)return;liveSyncPull();liveSyncTimer=setInterval(()=>liveSyncPull(),LIVE_SYNC_CONFIG.pollMs)}
function stopLiveSync(){clearInterval(liveSyncTimer);liveSyncTimer=null}
function liveSyncPush(){if(!LIVE_SYNC_CONFIG.apiBase)return;clearTimeout(liveSyncPush._t);const seq=localMutationSeq;liveSyncPush._t=setTimeout(async()=>{try{const snapshot=deepClone(state);const r=await fetch(LIVE_SYNC_CONFIG.apiBase+'/state',{method:'PUT',headers:{'content-type':'application/json','x-aurion-api-key':window.NMRC_INVENTORY_API_KEY||''},body:JSON.stringify({state:snapshot,clientId:storageGet('aurion_client_id','')})});if(!r.ok)throw new Error('HTTP '+r.status);lastPushedMutationSeq=Math.max(lastPushedMutationSeq,seq);liveSyncReady=true}catch(e){console.warn('Live sync push failed',e)}},80)}
function driveBackupSheets(){const sheets=[];Object.keys(reports).filter(k=>k!=='ccr'&&k!=='location').forEach(k=>sheets.push({name:reports[k].title.slice(0,31),rows:k==='summary'?summaryRows():(state.records[k]||[])}));const ccr=ccrVisibleRows();sheets.push({name:'CCR Management',rows:[{Metric:'Total Complaints',Count:ccr.length},{Metric:'New / Received',Count:ccr.length},{Metric:'Pending Reply',Count:ccr.filter(r=>String(r['Reply Required']||'').toLowerCase()==='yes'&&String(r['Reply Status']||'Not Replied')!=='Reply Sent').length},{Metric:'Reply Sent',Count:ccr.filter(r=>String(r['Reply Status']||'')==='Reply Sent').length},{Metric:'Resolved',Count:ccr.filter(r=>String(r['Resolution Status']||'Pending')==='Resolved').length},{Metric:'Pending Resolution',Count:ccr.filter(r=>String(r['Resolution Status']||'Pending')!=='Resolved').length}]});sheets.push({name:'Complaint Received',rows:ccr.map(r=>({'Name':r.Name,'Complaint Received Date/Time':r['Complaint Received Date/Time'],'Customer Gmail':r['Customer Gmail'],'App':r.App,'Amount':r.Amount,'Transaction Date/Time':r['Transaction Date/Time'],'UPI ID':r['UPI ID'],'UTR':r.UTR,'UPI Transaction ID':r['UPI Transaction ID'],'App Transaction ID':r['App Transaction ID'],'Payment Method':r['Payment Method'],'Transaction Status':r['Transaction Status'],'Reference ID':r['Reference ID']}))});sheets.push({name:'Complaint Reply Pending',rows:ccr.map(r=>({'Name':r.Name,'Reply Required':r['Reply Required'],'Reply To Gmail':r['Reply To Gmail'],'Reply Subject':r['Reply Subject'],'Reply Message':r['Reply Message'],'Replied By':r['Replied By'],'Reply Date & Time':r['Reply Date & Time'],'Reply Status':r['Reply Status'],'Resolution Status':r['Resolution Status']})).filter(r=>String(r['Reply Status']||'Not Replied')!=='Reply Sent'||String(r['Resolution Status']||'Pending')==='Pending')});sheets.push({name:'CCR Final Summary',rows:ccr.map(r=>Object.fromEntries(reports.ccr.fields.map(f=>[f,r[f]??''])))});sheets.push({name:'Agent Location History',rows:state.locations.map(x=>({'Employee Code':x.employeeCode||x.employeeId||x.userId||'','Employee ID':x.employeeId||x.userId||'','Name':x.name||x.employeeName||'','Login Date & Time':x.loginDateTime||'','Logout Date & Time':x.logoutDateTime||'','Date & Time':x.datetime,Latitude:x.lat,Longitude:x.lng,'GPS URL':x.gpsUrl||x.map||'','Map':x.map||x.gpsUrl||'','Location Name':x.locationName||''}))});sheets.push({name:'Deleted Location Archive',rows:(state.deletedLocationHistory||[]).map(x=>({'Employee Code':x.employeeCode||x.employeeId||'','Employee ID':x.employeeId||'','Name':x.name||'','Login Date & Time':x.loginDateTime||'','Logout Date & Time':x.logoutDateTime||'','Date & Time':x.datetime||'','Latitude':x.lat,'Longitude':x.lng,'GPS URL':x.gpsUrl||x.map||'','Location Name':x.locationName||'','Deleted From Portal At':x.deletedFromPortalAt||'','Deleted By':x.deletedFromPortalBy||''}))});sheets.push({name:'Deleted Records',rows:(state.deletedRecords||[]).map(x=>({Report:x.reportName,DeletedBy:x.deletedBy,DeletedAt:x.deletedAt,Record:JSON.stringify(x.record)}))});return sheets}
async function manualSyncNow(){
  try{
    if(LIVE_SYNC_CONFIG.apiBase){
      const r=await fetch(LIVE_SYNC_CONFIG.apiBase+'/state',{method:'PUT',headers:{'content-type':'application/json','x-aurion-api-key':window.NMRC_INVENTORY_API_KEY||''},body:JSON.stringify({state,clientId:storageGet('aurion_client_id','')})});
      if(!r.ok)throw new Error('Portal sync HTTP '+r.status);
    }
    if(LIVE_SYNC_CONFIG.driveBackupUrl) await backupToGoogleDrive();
    alert('Manual Sync completed successfully. Portal data and Google Drive backup are updated.');
  }catch(e){alert('Manual Sync failed: '+e.message)}
}
async function backupToGoogleDrive(silent=false){if(!LIVE_SYNC_CONFIG.driveBackupUrl)return silent?false:alert('Google Drive backup URL is not configured yet. Add NMRC_INVENTORY_DRIVE_BACKUP_URL in config.js.');try{const proxy=(LIVE_SYNC_CONFIG.apiBase||'/api')+'/drive-backup';const r=await fetch(proxy,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({backupUrl:LIVE_SYNC_CONFIG.driveBackupUrl,filename:'NMRC_INVENTORY_BACKUP.xlsx',sheetName:'NMRC_INVENTORY_BACKUP',sheets:driveBackupSheets(),deletedFolder:'NMRC_INVENTORY_DELETED',deletedRecords:state.deletedRecords||[],state,updatedAt:new Date().toISOString()})});const data=await r.json().catch(()=>({}));if(!r.ok||data.ok===false)throw new Error(data.error||('Backup endpoint returned '+r.status));if(!silent){let msg='Google Drive backup completed successfully.\n\nExcel: '+(data.xlsxUrl||'created in Drive')+'\nGoogle Sheet: '+(data.spreadsheetUrl||'created in Drive');alert(msg)}return true}catch(e){console.warn('Google Drive backup failed',e);if(!silent)alert('Google Drive backup failed: '+e.message);return false}}
let driveBackupTimer=null,driveBackupInterval=null;function scheduleDriveBackup(){if(!LIVE_SYNC_CONFIG.driveBackupUrl)return;clearTimeout(driveBackupTimer);driveBackupTimer=setTimeout(()=>{backupToGoogleDrive(true).catch(()=>{});},5000)}function startDriveBackupSync(){clearInterval(driveBackupInterval);if(!LIVE_SYNC_CONFIG.driveBackupUrl)return;driveBackupInterval=setInterval(()=>{if(currentUser)backupToGoogleDrive(true).catch(()=>{});},120000)}function stopDriveBackupSync(){clearInterval(driveBackupInterval);driveBackupInterval=null}
function openFinalSummaryExcel(){exportExcel('summary')}

const DEFAULT_STATIONS=['Noida Sector 51','Noida Sector 50','Noida Sector 76','Noida Sector 101','Noida Sector 81','NSEZ','Noida Sector 83','Noida Sector 137','Noida Sector 142','Noida Sector 143','Noida Sector 144','Noida Sector 145','Noida Sector 146','Noida Sector 147','Noida Sector 148','Knowledge Park II','Pari Chowk','Alpha 1','Delta 1','GNIDA Office','Depot Station'];
const DEFAULT_EQUIPMENT_TYPES=['TOM','TVM','TR','AG','EFO','ATM','Other'];
const DEFAULT_EQUIPMENT_NAMES=['AG','BIDI AG','Entry AG','Entry BIDI AG'];
const DEFAULT_EQUIPMENT_NUMBERS=['TOM 1','TOM 3','EDR','CBR','TVM'];
const COMPONENT_MASTER=['GV7 MB','Processor','Display Driver Board','Sensor Cable','Proximity Sensor','MIB Board','FEIG Faulty','Slave Side(BIDI) Flap Damage','Pcm Board faulty','Flap Damage','Display','QR Scanner','QR Glass','GV Sticker','SMPS','Lamp','Buzzer','Mother Board','Comm Cable','AG Sensor','Magnetic Plate'];
const INVENTORY_EXCEL_FIELDS=['S. No.','Date','STATION','System','SUB SYSTEM','EQUIPMENT NAME','Status','Remark','Action Remarks','GV 7 Display Faulty Count',...COMPONENT_MASTER];
const BASE_REPORTS={
 station:{title:'Station AG Inspection',fields:['Date','Station Name','Equipment Type','Equipment Number','Equipment Name','Component / Part','Component Count','Equipment Status / AG Detail','Status','Transaction File Pending','Equipment Photo']},
 pm:{title:'PM Checklist',fields:['Date','Agent','Station','Serial Number','Checklist Item','Status','Remarks']},
 failure:{title:'Failure Entry',fields:['Date','Time','Agent','Station','Serial Number','Failure Type','L1','PCR','D1','Status','Remarks']},
 material:{title:'Material Entry',fields:['Date','Agent','Station','Material','Quantity','Serial Number','Remarks']},
 inventory:{title:'Inventory Entry',fields:['Date','Agent','Station','Material','Opening','Received','Issued','Closing','Serial Number']},
 addinventory:{title:'Add New Inventory',fields:['Date','Material','Unit','Opening Stock','Added Quantity','Serial Number','Remarks']},
 summary:{title:'Final Summary Report',fields:['Date','Date & Time','Agent','Employee ID / User Name','Station','System','Sub System','Equipment Name','Status','Remark','Action Remarks','S. No.','GV 7 Display Faulty Count',...COMPONENT_MASTER,'Product Name','Serial Number','Part / Product Photo','Latitude','Longitude','Map URL','Entry Photo','Failure Count','L1 Faulty','PCR Faulty','D1 Faulty','Material Quantity','Inventory Closing','Remarks']},
location:{title:'Agent Location History',fields:['Employee Code','Employee ID','Name','Date & Time','Latitude','Longitude','GPS URL','Map','Location Name']},
ccr:{title:'CCR Management',fields:['Name','Complaint Received Date/Time','Customer Gmail','App','Amount','Transaction Date/Time','UPI ID','UTR','UPI Transaction ID','App Transaction ID','Payment Method','Transaction Status','Reference ID','Reply Required','Reply To Gmail','Reply Subject','Reply Message','Replied By','Reply Date & Time','Reply Status','Resolution Status']}
};
const STANDARD_ENTRY_FIELDS=[];
// Each report owns its exact fields. Do not inject generic fields into other report pages.
function applyStandardFields(){return true}
const STATIC_ROLES=[['station','Station AG Inspection'],['pm','PM Checklist'],['failure','Failure Entry'],['material','Material Entry'],['inventory','Inventory Entry'],['addinventory','Add New Inventory'],['summary','Final Summary Report'],['location','Agent Location History']];
function deepClone(v){return JSON.parse(JSON.stringify(v))}
let reports=deepClone(BASE_REPORTS);
let state={records:{},locations:[],loginLogs:[],deletedRecords:[],deletedLocationHistory:[],purgedRecordKeys:[],permanentDeletedRecordKeys:[],deletedStations:[],deletedEquipmentMaster:[],deletedComponents:[],dynamic:[],users:[],activities:[],settings:{},stations:[],equipmentMaster:[],componentMaster:[]};
try{const raw=localStorage.getItem('aurion_state_v18'); if(raw){const parsed=JSON.parse(raw); if(parsed&&typeof parsed==='object') state={...state,...parsed};}}catch(e){console.warn('State load failed; starting clean state',e)}
Object.keys(BASE_REPORTS).forEach(k=>state.records[k] ||= []);
(state.dynamic||[]).forEach(k=>{if(k&&state.reportDefs?.[k])reports[k]=state.reportDefs[k];});
state.reportDefs ||= {}; state.stations ||= []; DEFAULT_STATIONS.forEach(x=>{if(!state.stations.some(v=>String(v).toLowerCase()===x.toLowerCase())&&!state.deletedStations?.includes(x)) state.stations.push(x)}); state.equipmentMaster ||= []; DEFAULT_EQUIPMENT_NAMES.forEach(x=>{if(!state.equipmentMaster.some(v=>String(v?.name||'').toLowerCase()===x.toLowerCase())&&!state.deletedEquipmentMaster?.includes(`AG|${x}|`)) state.equipmentMaster.push({type:'AG',name:x,number:''})}); [{type:'TOM',name:'TOM',number:'TOM 1'},{type:'TOM',name:'TOM',number:'TOM 3'},{type:'Other',name:'EDR',number:'EDR'},{type:'Other',name:'CBR',number:'CBR'},{type:'TVM',name:'TVM',number:'TVM'}].forEach(x=>{const k=`${x.type}|${x.name}|${x.number}`;if(!state.equipmentMaster.some(v=>`${v.type}|${v.name}|${v.number}`===k)&&!state.deletedEquipmentMaster?.includes(k))state.equipmentMaster.push(x)}); state.componentMaster ||= []; state.pmChecklistItems ||= []; (state.records.pm||[]).forEach(r=>{const v=String(r?.['Checklist Item']||'').trim();if(v&&!state.pmChecklistItems.includes(v))state.pmChecklistItems.push(v)}); (state.records.station||[]).forEach(r=>{const type=String(r?.['Equipment Type']||'').trim(),name=String(r?.['Equipment Name']||'').trim(),number=String(r?.['Equipment Number']||'').trim();if(type&&name&&number&&!state.equipmentMaster.some(x=>String(x.type)===type&&String(x.name)===name&&String(x.number)===number))state.equipmentMaster.push({type,name,number});const st=String(r?.['Station Name']||r?.STATION||'').trim();if(st&&!state.stations.includes(st))state.stations.push(st)}); state.deletedLocationHistory ||= []; COMPONENT_MASTER.forEach(x=>{if(!state.componentMaster.some(v=>String(v).toLowerCase()===x.toLowerCase())) state.componentMaster.push(x)}); applyStandardFields();
let current='station',editIndex=null,userEditIndex=null,currentUser=null; let currentSessionId=''; let liveLocationTimer=null;
const $=id=>document.getElementById(id);
function save(){localStorage.setItem('aurion_state_v18',JSON.stringify(state));localMutationSeq++;liveSyncPush();scheduleDriveBackup();}
function esc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function attr(v){return esc(v).replace(/\n/g,' ')}
function isAdmin(){return currentUser?.id==='admin'}
function permsFor(user,key){if(isAdmin())return {view:true,add:true,edit:true,delete:true}; if(key==='summary')return {view:false,add:false,edit:false,delete:false}; if(key==='location')return {view:false,add:false,edit:false,delete:false}; const all=user?.allRoles===true || (Array.isArray(user?.roles)&&STATIC_ROLES.every(([k])=>user.roles.includes(k))); if(all && STATIC_ROLES.some(([k])=>k===key))return {view:true,add:true,edit:true,delete:true}; const p=user?.permissions?.[key]; if(p)return {view:!!p.view,add:!!p.add,edit:!!p.edit,delete:!!p.delete}; return {view:false,add:false,edit:false,delete:false};}
function roleLabel(key){return reports[key]?.title||STATIC_ROLES.find(x=>x[0]===key)?.[1]||key}
function storageGet(key, fallback=''){try{return localStorage.getItem(key)??fallback}catch(e){return fallback}}
function storageSet(key,value){try{localStorage.setItem(key,value);return true}catch(e){return false}}
async function login(){
 try{
  // Pull the latest central users before authentication so APKs can use users created/updated by Admin.
  if(LIVE_SYNC_CONFIG.apiBase){ try{ await liveSyncPull(); }catch(_){} }
  startLiveSync();
  startDriveBackupSync();
  const userEl=$('username'),passEl=$('password');
  const u=String(userEl?.value||'').trim(), p=String(passEl?.value||'');
  if(!u||!p){alert('Please enter Username and Password.');return false}
  let found=null;
  if(u.toLowerCase()==='admin'){ const configuredAdminPassword=String(state.adminPassword||'').trim(); const localAdminPassword=String(storageGet('admin_password','')).trim(); const adminPasswordOk=configuredAdminPassword ? p===configuredAdminPassword : (p===localAdminPassword || p==='admin123'); if(adminPasswordOk) found={id:'admin',name:'Admin',mobile:storageGet('admin_mobile',''),photo:storageGet('admin_photo',''),role:'Admin'}; }
  else found=(state.users||[]).find(x=>String(x?.id||'').trim().toLowerCase()===u.toLowerCase()&&String(x?.password??'')===p);
  if(!found){alert('Invalid username or password.');return false}
  const now=new Date().toISOString();
  currentSessionId=`${String(found.id||'admin')}-${Date.now()}-${Math.random().toString(36).slice(2,8)}`;
  if(found.id==='admin') storageSet('admin_last_login',now); else {found.lastLogin=now;save()}
  currentUser={...found,lastLogin:now,loginDateTime:now,sessionId:currentSessionId};
  state.loginLogs ||= [];
  state.loginLogs.push({sessionId:currentSessionId,employeeCode:found.employeeCode||found.code||found.id||'',employeeId:found.id||'',name:found.name||'',loginDateTime:now,logoutDateTime:''});
  save();
  applyCCRRolePermissions(currentUser);
  storageSet('aurion_session_v1',JSON.stringify(currentUser));
  resetIdleLogoutTimer();
  const lp=$('loginPage'), app=$('app');
  if(!lp||!app) throw new Error('Login screen not found');
  lp.classList.add('hidden'); app.classList.remove('hidden');
  setHeader(); renderNav(); renderDashboard(); showDashboard(); captureSessionLocation('login'); ccrAutoPoll();
  return false;
 }catch(e){console.error('Login failed',e);alert('Login error: '+(e?.message||'Please try again.'));return false}
}
window.login=login;

['click','touchstart','keydown','mousemove','scroll'].forEach(ev=>document.addEventListener(ev,markUserActivity,{passive:true}));
document.addEventListener('DOMContentLoaded',()=>{
  const btn=$('loginBtn');
  if(btn){
    btn.type='button';
    btn.onclick=(e)=>{e.preventDefault();login();};
  }
  const pass=$('password');
  if(pass) pass.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();login();}});
  try{
    const raw=storageGet('aurion_session_v1','');
    if(raw){
      const saved=JSON.parse(raw);
      if(saved&&saved.id){
        currentUser=saved; currentSessionId=saved.sessionId||'';
        applyCCRRolePermissions(currentUser);
        $('loginPage')?.classList.add('hidden');
        $('app')?.classList.remove('hidden');
        setHeader();renderNav();renderDashboard();showDashboard();startLiveSync();captureSessionLocation('login');resetIdleLogoutTimer();
      }
    }
  }catch(e){storageSet('aurion_session_v1','');console.warn('Session restore failed',e)}
});
function openForgotPassword(){$('forgotModal')?.classList.remove('hidden');$('forgotStep1')?.classList.remove('hidden');$('forgotStep2')?.classList.add('hidden');$('forgotUser').value='';$('forgotOtp').value='';$('forgotNewPassword').value='';$('forgotMsg').textContent='';setTimeout(()=>$('forgotUser')?.focus(),50)}
function closeForgotPassword(){$('forgotModal')?.classList.add('hidden')}
let forgotContext=null;
function maskMobile(m){const x=String(m||'').replace(/\D/g,'');return x.length>=4?'******'+x.slice(-4):'the registered mobile number'}
function requestForgotOtp(){const id=$('forgotUser').value.trim();if(!id)return alert('Enter Employee ID / Username.');const user=state.users.find(x=>String(x.id).toLowerCase()===id.toLowerCase());if(!user)return alert('Employee ID not found.');if(!user.mobile)return alert('No mobile number is registered for this user.');const otp=String(Math.floor(1000+Math.random()*9000));forgotContext={id:user.id,otp,expires:Date.now()+5*60*1000};console.log('NMRC Inventory demo OTP:',otp);$('forgotMasked').textContent=`A 4 digit OTP was generated for ${maskMobile(user.mobile)}.`;$('forgotStep1').classList.add('hidden');$('forgotStep2').classList.remove('hidden');$('forgotMsg').textContent='SMS gateway is not connected in this test ZIP. Production API hook is ready; connect an SMS provider to deliver this OTP by SMS.';alert(`Test OTP: ${otp}\n\nConnect the SMS provider API for real SMS delivery to the registered mobile number.`)}
function verifyForgotOtp(){const otp=$('forgotOtp').value.trim();const pass=$('forgotNewPassword').value;if(!/^\d{4}$/.test(otp))return alert('OTP must be exactly 4 digits.');if(!pass)return alert('Enter a new password.');if(!forgotContext||Date.now()>forgotContext.expires)return alert('OTP expired. Request a new OTP.');if(otp!==forgotContext.otp)return alert('Invalid OTP.');const user=state.users.find(x=>x.id===forgotContext.id);if(!user)return alert('User not found.');user.password=pass;save();forgotContext=null;alert('Password reset successfully. Please login with your new password.');closeForgotPassword()}
function changeAdminPassword(e){e.preventDefault();if(!isAdmin())return alert('Admin access required.');const cur=$('adminCurrentPassword')?.value||'';const np=$('adminNewPassword')?.value||'';const cp=$('adminConfirmPassword')?.value||'';const actual=String(state.adminPassword||storageGet('admin_password','admin123'));if(cur!==actual)return alert('Current Admin password is incorrect.');if(np.length<4)return alert('New password must be at least 4 characters.');if(np!==cp)return alert('New password and confirmation do not match.');state.adminPassword=np;storageSet('admin_password',np);save();$('adminCurrentPassword').value='';$('adminNewPassword').value='';$('adminConfirmPassword').value='';if($('adminPasswordMsg'))$('adminPasswordMsg').textContent='Admin password changed successfully. Use the new password at next login.';alert('Admin password changed successfully.');}
function togglePassword(){const p=$('password');p.type=p.type==='password'?'text':'password'}
let idleLogoutTimer=null;
function resetIdleLogoutTimer(){
 clearTimeout(idleLogoutTimer);
 if(!currentUser)return;
 idleLogoutTimer=setTimeout(()=>{if(currentUser){alert('Session expired after 3 minutes of inactivity. Please login again.');logout();}},180000);
}
function markUserActivity(){if(currentUser)resetIdleLogoutTimer()}
function logout(){
 clearTimeout(idleLogoutTimer);
 const logoutTime=new Date().toISOString();
 if(currentUser){
   state.loginLogs ||= [];
   const log=state.loginLogs.find(x=>x.sessionId===currentSessionId);
   if(log)log.logoutDateTime=logoutTime;
   state.locations ||= [];
   state.locations.forEach(x=>{if(x.sessionId===currentSessionId&&x.event==='login')x.logoutDateTime=logoutTime;});
   captureSessionLocation('logout',()=>save());
   save();
 }
 stopLiveLocationTracking();
 currentUser=null; currentSessionId='';
 try{localStorage.removeItem('aurion_session_v1')}catch(_){}
 stopLiveSync();
 stopDriveBackupSync();
 $('app')?.classList.add('hidden'); $('loginPage')?.classList.remove('hidden'); if($('password'))$('password').value=''; closeSidebar();
}
function adminLogoSvg(){return 'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"%3E%3Crect width="100" height="100" rx="16" fill="%230a6574"/%3E%3Ctext x="50" y="62" text-anchor="middle" font-family="Arial,sans-serif" font-size="38" font-weight="800" fill="white"%3EAP%3C/text%3E%3C/svg%3E'}
function setHeader(){ const hn=$('headerName'); if(hn)hn.textContent=currentUser.name; const ha=$('headerAvatar'); if(ha)ha.src=isAdmin()?adminLogoSvg():currentUser.photo||avatarSvg(); const dd=$('adminDropdown'); if(!dd)return; dd.innerHTML=`<div class="admin-user"><b>${esc(currentUser.name)}</b><div>Employee ID: ${esc(currentUser.id)}</div><div>Mobile: ${esc(currentUser.mobile||'Not set')}</div><div>Role: ${esc(currentUser.role||'Agent')}</div><div>Last Login: ${currentUser.lastLogin?esc(new Date(currentUser.lastLogin).toLocaleString()):'—'}</div>${isAdmin()?'':'<div class="photo-note">Profile photo managed by Admin</div>'}</div>${isAdmin()?'<button type="button" onclick="showSettings();closeAdminMenu()">🔐 Change Admin Password</button>':''}<button onclick="logout()">Logout</button>`; if($('sessionInfo'))$('sessionInfo').innerHTML=`<p><b>${esc(currentUser.name)}</b> • ${esc(currentUser.id)} • Logged in ${esc(new Date(currentUser.lastLogin).toLocaleString())}</p>`;}
function avatarSvg(){return 'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"%3E%3Ccircle cx="50" cy="50" r="50" fill="%23dfe6ee"/%3E%3Ccircle cx="50" cy="40" r="17" fill="%23899"/%3E%3Cpath d="M20 85c4-20 56-20 60 0" fill="%23899"/%3E%3C/svg%3E'}
function changeAdminPhoto(e){if(!isAdmin())return;const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{localStorage.setItem('admin_photo',r.result);currentUser.photo=r.result;setHeader()};r.readAsDataURL(f)}
let cameraStream=null,cameraTarget=null;
async function openCamera(target){
 cameraTarget=target;
 const modal=$('cameraModal'),video=$('cameraVideo'),hint=$('cameraHint');
 if(!modal||!video)return;
 modal.classList.add('show'); hint.textContent='Starting camera…';
 try{
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia) throw new Error('Camera API unavailable. Open this portal on HTTPS or localhost.');
  cameraStream=await navigator.mediaDevices.getUserMedia({video:{facingMode:target==='employee'?'user':'environment'},audio:false});
  video.srcObject=cameraStream; await video.play(); hint.textContent='Camera ready. Tap Capture Photo.';
 }catch(err){hint.textContent='Camera could not start: '+err.message;}
}
function closeCamera(){if(cameraStream){cameraStream.getTracks().forEach(t=>t.stop());cameraStream=null}const v=$('cameraVideo');if(v)v.srcObject=null;$('cameraModal')?.classList.remove('show');cameraTarget=null}
function captureCameraPhoto(){
 const v=$('cameraVideo'),c=$('cameraCanvas');
 if(!cameraStream||!v||!c||!v.videoWidth){alert('Camera is not ready yet.');return}
 c.width=v.videoWidth;c.height=v.videoHeight;c.getContext('2d').drawImage(v,0,0,c.width,c.height);
 const data=c.toDataURL('image/jpeg',.88);
 if(cameraTarget==='employee'){const el=$('employeePhotoData');if(el)el.value=data;const prev=$('employeePhotoPreview');if(prev)prev.innerHTML=`<img src="${data}" alt="Employee">`}
 if(cameraTarget==='entry'){const el=$('entryPhoto');if(el)el.value=data;const prev=$('entryPhotoPreview');if(prev)prev.innerHTML=`<img src="${data}" alt="Entry">`}
 closeCamera();
}
function toggleAdminMenu(){const d=$('adminDropdown');if(d)d.classList.toggle('show')}
function toggleSidebar(){$('sidebar').classList.toggle('open');$('overlay').classList.toggle('show')}
function closeSidebar(){$('sidebar').classList.remove('open');$('overlay').classList.remove('show')}
const CCR_REPORT_KEY='ccr';
let ccrView='main';
let ccrGmailBusy=false,ccrGmailTimer=null;
const CCR_ROLE_OPTIONS=['CCR Admin','CCR Manager','CCR User','CCR Reply User','CCR View Only'];
function getCCRRole(user){return String(user?.ccrRole||'').trim();}
function getCCRRoles(user){return Array.isArray(user?.ccrRoles)&&user.ccrRoles.length?user.ccrRoles:(getCCRRole(user)?[getCCRRole(user)]:[]);}
const CCR_REPORT_KEYS={management:'management',received:'received',status:'status',final:'final'};
function applyCCRRolePermissions(user){
  if(!user)return;
  user.permissions ||= {};
  user.ccrPermissions ||= {};
  const legacy=user.permissions[CCR_REPORT_KEY];
  if(legacy && !Object.keys(user.ccrPermissions).length){
    Object.keys(CCR_REPORT_KEYS).forEach(k=>user.ccrPermissions[k]={...legacy});
  }
  const roles=getCCRRoles(user);
  const hasExplicit=Object.keys(CCR_REPORT_KEYS).some(k=>user.ccrPermissions?.[k] && Object.values(user.ccrPermissions[k]).some(Boolean));
  if(!hasExplicit && roles.length){
    const grants={
      'CCR Admin':{view:true,add:true,edit:true,delete:true},
      'CCR Manager':{view:true,add:true,edit:true,delete:true},
      'CCR User':{view:true,add:true,edit:true,delete:false},
      'CCR Reply User':{view:true,add:false,edit:true,delete:false},
      'CCR View Only':{view:true,add:false,edit:false,delete:false}
    };
    Object.keys(CCR_REPORT_KEYS).forEach(k=>{
      const g=roles.map(r=>grants[r]).filter(Boolean);
      user.ccrPermissions[k]=g.reduce((a,x)=>({view:a.view||x.view,add:a.add||x.add,edit:a.edit||x.edit,delete:a.delete||x.delete}),{view:false,add:false,edit:false,delete:false});
    });
  }
}
function ccrPerms(user,key){
  if(isAdmin())return {view:true,add:true,edit:true,delete:true};
  applyCCRRolePermissions(user);
  return user?.ccrPermissions?.[key]||{view:false,add:false,edit:false,delete:false};
}
function ccrViewRows(rows){
  if(ccrView==='reply') return rows.filter(r=>String(r['Reply Status']||'Not Replied')!=='Reply Sent');
  if(ccrView==='status') return rows.filter(r=>String(r['Reply Status']||'Not Replied')!=='Reply Sent' || String(r['Resolution Status']||'Pending')==='Pending');
  return rows;
}
function openCCRView(view){
  const permKey=view==='main'?'management':view==='received'?'received':(view==='reply'||view==='status')?'status':'final';
  if(!currentUser||!ccrPerms(currentUser,permKey).view){alert('You do not have View permission for this CCR report.');return}
  ccrView=view||'main'; current=CCR_REPORT_KEY; editIndex=null; showPage('report'); closeSidebar(); renderReport();
}
function toggleCCRMenu(){const d=$('ccrSub');if(d)d.classList.toggle('hidden');}

function isCCRUser(){return !!currentUser && (isAdmin() || Object.keys(CCR_REPORT_KEYS).some(k=>ccrPerms(currentUser,k).view));}
function ccrVisibleRows(){const rows=state.records[CCR_REPORT_KEY]||[];return isAdmin()?rows:rows.filter(x=>String(x?._userId||'')===String(currentUser?.id||''));}
function ccrReplyFor(row){const status=String(row?.['Transaction Status']||row?.Status||'').toLowerCase();const name=String(row?.Name||'').trim();const amount=String(row?.Amount||'').trim();const greeting=name?`Dear ${name},`:'Dear Customer,';if(status.includes('success'))return `${greeting}\n\nWe have received your payment${amount?` of ${amount}`:''} successfully. Thank you.`;if(status.includes('fail'))return `${greeting}\n\nWe could not confirm the payment${amount?` of ${amount}`:''}. Please share the transaction screenshot or UTR number so we can check it.`;if(status.includes('pending'))return `${greeting}\n\nYour payment${amount?` of ${amount}`:''} is currently pending. We are checking the transaction status and will update you once it is confirmed.`;return `${greeting}\n\nWe are reviewing your transaction details. Please share any missing transaction reference or UTR number if available.`;}
function ccrSubject(row){const status=String(row?.['Transaction Status']||row?.Status||'').trim();return status?`Payment ${status} - Transaction Review`:'Transaction Review';}
function ccrGmailUrl(row){const to=String(row?.['Reply To Gmail']||row?.Gmail||'').trim();if(!to)return '';const subject=String(row?.['Reply Subject']||ccrSubject(row));const body=String(row?.['Reply Message']||ccrReplyFor(row));return `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(to)}&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;}
async function gmailStatus(){try{const r=await fetch((LIVE_SYNC_CONFIG.apiBase||'/api')+'/gmail/status',{headers:{'x-aurion-api-key':window.NMRC_INVENTORY_API_KEY||''}});return r.ok?await r.json():{connected:false,configured:false};}catch(_){return {connected:false,configured:false}}}
async function connectCCRMail(){const st=await gmailStatus();if(!st.configured)return alert('Gmail OAuth is not configured on the portal worker yet. Add the Google OAuth Client ID/Secret and redirect URI first.');if(st.connected)return alert(`Gmail already connected${st.email?': '+st.email:''}.`);const r=await fetch((LIVE_SYNC_CONFIG.apiBase||'/api')+'/gmail/connect',{headers:{'x-aurion-api-key':window.NMRC_INVENTORY_API_KEY||''}});const j=await r.json();if(j.url)window.location.href=j.url;else alert(j.error||'Unable to start Gmail connection.');}
async function processGmailMessages(silent=false){if(ccrGmailBusy)return;ccrGmailBusy=true;const status=$('ccrGmailStatus');try{const st=await gmailStatus();if(!st.connected){if(!silent&&st.configured)alert('Please connect the complaint Gmail first.');return;}if(status)status.textContent='Checking Gmail…';const r=await fetch((LIVE_SYNC_CONFIG.apiBase||'/api')+'/gmail/messages?max=25',{headers:{'x-aurion-api-key':window.NMRC_INVENTORY_API_KEY||''}});const j=await r.json();if(!j.ok)throw new Error(j.error||'Gmail read failed');let added=0;const ack=[];for(const m of (j.messages||[])){try{let text=`${m.subject||''}\n${m.from||''}\n${m.text||''}`;for(const img of (m.images||[])){try{const ar=await fetch(`${LIVE_SYNC_CONFIG.apiBase||'/api'}/gmail/attachment?messageId=${encodeURIComponent(m.id)}&attachmentId=${encodeURIComponent(img.attachmentId)}`,{headers:{'x-aurion-api-key':window.NMRC_INVENTORY_API_KEY||''}});const aj=await ar.json();if(aj?.data&&typeof Tesseract!=='undefined'){const bin=atob(String(aj.data).replace(/-/g,'+').replace(/_/g,'/'));const bytes=Uint8Array.from(bin,c=>c.charCodeAt(0));const blob=new Blob([bytes],{type:img.mimeType||'image/jpeg'});const ocr=await Tesseract.recognize(blob,'eng');text+='\n'+(ocr?.data?.text||'');}}catch(e){console.warn('Gmail attachment OCR failed',img.filename,e)}}let row=ccrParseText(text,`Gmail: ${m.subject||m.id}`);const sender=(String(m.from||'').match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i)||[])[0]||'';if(sender){row['Customer Gmail']=sender;}if(!row['Reply To Gmail'])row['Reply To Gmail']=sender;row['Reply Required']=row.Gmail?'Yes':'No';row['Reply Subject']=ccrSubject(row);row['Reply Message']=ccrReplyFor(row);row.Source=`Gmail: ${m.subject||m.id}`;row._gmailMessageId=m.id;row._recordId=`gmail-${m.id}`;row._gmailDate=m.date||'';row._userId=currentUser.id;row._userName=currentUser.name;row._savedAt=new Date().toISOString();row['Reply Status']='Not Replied';row['Resolution Status']='Pending';state.records[CCR_REPORT_KEY] ||= [];state.records[CCR_REPORT_KEY].push(row);added++;ack.push(m.id);}catch(e){console.warn('Gmail complaint processing failed',m.id,e)}}if(ack.length){await fetch((LIVE_SYNC_CONFIG.apiBase||'/api')+'/gmail/ack',{method:'POST',headers:{'content-type':'application/json','x-aurion-api-key':window.NMRC_INVENTORY_API_KEY||''},body:JSON.stringify({ids:ack})});state.activities.push(`CCR imported ${added} new Gmail complaint${added===1?'':'s'} by ${currentUser.name}`);save();renderCCRReport();}if(status)status.textContent=`Gmail: ${added} new complaint${added===1?'':'s'} imported${st.email?' • '+st.email:''}.`;if(!silent&&!added)status.textContent=`Gmail: no new complaints${st.email?' • '+st.email:''}.`;}catch(e){console.warn('CCR Gmail sync failed',e);if(status)status.textContent='Gmail sync error: '+e.message;}finally{ccrGmailBusy=false;}}
function ccrAutoPoll(){clearInterval(ccrGmailTimer);if(currentUser&&ccrPerms(currentUser,'received').view)processGmailMessages(true);ccrGmailTimer=setInterval(()=>{if(currentUser&&ccrPerms(currentUser,'received').view)processGmailMessages(true)},30000);}
function ccrMarkReply(i){const rows=state.records[CCR_REPORT_KEY]||[],row=rows[i];if(!row)return;if(!isAdmin()&&!ccrPerms(currentUser,'status').edit)return alert('Reply edit permission is not granted.');row['Reply Status']='Reply Sent';row['Replied By']=currentUser.name||currentUser.id;row['Reply Date & Time']=new Date().toLocaleString();if(!row['Resolution Status']||row['Resolution Status']==='Pending')row['Resolution Status']='Pending';save();renderCCRReport();}
function ccrSetResolution(i,status){const rows=state.records[CCR_REPORT_KEY]||[],row=rows[i];if(!row)return;if(!isAdmin()&&!ccrPerms(currentUser,'status').edit)return alert('Resolution edit permission is not granted.');row['Resolution Status']=status;save();renderCCRReport();}
function renderCCRReport(){
 const p=ccrPerms(currentUser,ccrView==='main'?'management':ccrView==='received'?'received':'status'), allRows=ccrVisibleRows(), rows=ccrViewRows(allRows);
 const from=$('ccrFrom')?.value||'', to=$('ccrTo')?.value||'';
 const periodRows=allRows.filter(r=>{const d=String(r['Complaint Received Date/Time']||r.Date||'').slice(0,10);return (!from||d>=from)&&(!to||d<=to)});
 const received=allRows.length;
 const newComplaints=periodRows.length;
 const replied=allRows.filter(r=>String(r['Reply Status']||'')==='Reply Sent').length;
 const pendingReply=allRows.filter(r=>String(r['Reply Required']||'').toLowerCase()==='yes'&&String(r['Reply Status']||'Not Replied')!=='Reply Sent').length;
 const resolved=allRows.filter(r=>String(r['Resolution Status']||'Pending')==='Resolved').length;
 const pendingResolution=allRows.filter(r=>String(r['Resolution Status']||'Pending')!=='Resolved').length;
 const upload=p.add?`<div class="panel ccr-upload-panel"><div class="form-head"><div><h3>Complaint Intake</h3><div class="muted">Connected Gmail is the primary source. Manual screenshot upload remains available as backup.</div></div><span class="admin-badge">CCR</span></div><div class="form-grid"><div class="field full"><div class="actions"><button class="btn primary" type="button" onclick="connectCCRMail()">Connect Complaint Gmail</button><button class="btn primary" type="button" onclick="processGmailMessages(false)">Check New Gmail Now</button><button class="btn gray" type="button" onclick="document.getElementById('ccrFiles').click()">Upload Screenshot Manually</button><span id="ccrGmailStatus" class="muted"></span></div></div><div class="field full"><input id="ccrFiles" type="file" accept="image/*" multiple style="display:none" onchange="processCCRFiles()"><div id="ccrOCRStatus" class="muted"></div></div></div></div>`:'';
 const dashboard=`<div class="ccr-dashboard"><div class="panel ccr-filter-panel"><div class="form-grid"><div class="field"><label>From Date</label><input id="ccrFrom" type="date" value="${attr(from)}" onchange="renderCCRReport()"></div><div class="field"><label>To Date</label><input id="ccrTo" type="date" value="${attr(to)}" onchange="renderCCRReport()"></div><div class="field"><label>Dashboard</label><input value="CCR Management Dashboard" readonly></div></div></div><div class="ccr-chart-grid"><div class="ccr-chart-card c1"><span>New Complaints</span><strong>${newComplaints}</strong><small>Selected period</small><div class="mini-bar"><i style="width:${Math.min(100,newComplaints?Math.max(8,newComplaints*8):0)}%"></i></div></div><div class="ccr-chart-card c2"><span>Total Received Complaints</span><strong>${received}</strong><small>All received</small><div class="mini-bar"><i style="width:${Math.min(100,received?Math.max(8,received*5):0)}%"></i></div></div><div class="ccr-chart-card c3"><span>Replied Complaints</span><strong>${replied}</strong><small>Reply Sent</small><div class="mini-bar"><i style="width:${received?Math.min(100,Math.round(replied/received*100)):0}%"></i></div></div><div class="ccr-chart-card c4"><span>Pending Complaints</span><strong>${pendingReply}</strong><small>Reply pending</small><div class="mini-bar"><i style="width:${received?Math.min(100,Math.round(pendingReply/received*100)):0}%"></i></div></div><div class="ccr-chart-card c5"><span>Closed / Resolved Complaints</span><strong>${resolved}</strong><small>Resolution completed</small><div class="mini-bar"><i style="width:${received?Math.min(100,Math.round(resolved/received*100)):0}%"></i></div></div><div class="ccr-chart-card c6"><span>Complaint Status Overview</span><div class="status-bars"><b><em>New / Received</em><i style="width:${received?100:0}%">${received}</i></b><b><em>Replied</em><i style="width:${received?Math.round(replied/received*100):0}%">${replied}</i></b><b><em>Pending</em><i style="width:${received?Math.round(pendingReply/received*100):0}%">${pendingReply}</i></b><b><em>Closed / Resolved</em><i style="width:${received?Math.round(resolved/received*100):0}%">${resolved}</i></b></div></div></div></div>`;
 const employeeRows=Object.entries(allRows.reduce((m,r)=>{const n=String(r._userName||r._userId||'Unassigned');m[n] ||= {total:0,pending:0};m[n].total++;if(String(r['Reply Status']||'Not Replied')!=='Reply Sent'||String(r['Resolution Status']||'Pending')!=='Resolved')m[n].pending++;return m},{})).map(([name,v])=>`<tr><td>${esc(name)}</td><td>${v.total}</td><td>${v.pending}</td></tr>`).join('')||'<tr><td colspan="3" class="empty">No CCR employee workload yet.</td></tr>';
 const employeePanel=`<div class="panel"><h3>CCR Team Workload</h3><table><thead><tr><th>Employee Name</th><th>Complaint Count</th><th>Pending Count</th></tr></thead><tbody>${employeeRows}</tbody></table></div>`;
 $('reportActions').innerHTML=`<button class="btn gray" onclick="exportExcel('${CCR_REPORT_KEY}')">Export Excel</button><button class="btn gray" onclick="exportPDF('${CCR_REPORT_KEY}')">Export PDF</button>`;
 const titles={main:'CCR Management Dashboard',received:'Complaint Receive',reply:'Complaint Reply',status:'Pending Status',final:'Final Summary'};
 $('reportTitle').textContent=titles[ccrView]||'Final Summary';$('reportDesc').textContent=ccrView==='main'?'Six-chart CCR dashboard and team workload.':'CCR workflow report';const ccrFilterPanel=ccrView==='main'?'':`<div class="panel report-filters"><div class="form-grid"><div class="field"><label>From Date</label><input id="ccrFrom" type="date" value="${attr(from)}" onchange="renderCCRReport()"></div><div class="field"><label>To Date</label><input id="ccrTo" type="date" value="${attr(to)}" onchange="renderCCRReport()"></div><div class="field"><label>Status</label><select id="ccrStatusFilter" onchange="renderCCRReport()"><option value="">All Status</option><option value="reply sent">Reply Sent</option><option value="not replied">Not Replied</option><option value="resolved">Resolved</option><option value="pending">Pending</option></select></div><div class="field"><label>Search</label><input id="ccrSearchFilter" placeholder="Search CCR data" onchange="renderCCRReport()"></div><div class="field full"><div class="actions"><button class="btn gray" type="button" onclick="renderCCRReport()">Apply Filter</button><span class="user-count">${rows.length} records</span></div></div></div></div>`;
 $('reportForm').innerHTML=ccrView==='main'?upload+dashboard+employeePanel:upload+ccrFilterPanel;
 if(ccrView==='main'){$('thead').innerHTML='';$('tbody').innerHTML='';return}
 const heads=reports[CCR_REPORT_KEY].fields;const tableRows=currentCCRFilteredRows();$('thead').innerHTML='<tr>'+heads.map(f=>`<th>${esc(f)}</th>`).join('')+'<th>Actions</th></tr>';$('tbody').innerHTML=tableRows.map(row=>{const realIndex=(state.records[CCR_REPORT_KEY]||[]).indexOf(row);const gmail=ccrGmailUrl(row);let actions=`<button class="btn gray small-btn" onclick="ccrCheck(${realIndex})">${row._checked==='Yes'?'✓ Checked':'✓ Check'}</button>`;const cp=ccrPerms(currentUser,ccrView);if(ccrView==='final'){if(cp.edit)actions+=` <button class="btn primary small-btn" onclick="editCCRRecord(${realIndex})">✏️ Edit</button>`;if(cp.delete)actions+=` <button class="btn danger small-btn" onclick="deleteCCRRecord(${realIndex})">🗑️ Delete</button>`;}else{if(gmail)actions+=` <button class="btn primary small-btn" onclick="openCCRGmail(${realIndex})">Open Gmail</button>`;if(gmail&&row['Reply Status']!=='Reply Sent'&&cp.edit)actions+=` <button class="btn gray small-btn" onclick="ccrMarkReply(${realIndex})">Mark Reply Sent</button>`;if(ccrView==='status'&&cp.edit)actions+=row['Resolution Status']==='Pending'?` <button class="btn gray small-btn" onclick="ccrSetResolution(${realIndex},'Resolved')">Resolve</button>`:` <button class="btn gray small-btn" onclick="ccrSetResolution(${realIndex},'Pending')">Set Pending</button>`;}return `<tr>${heads.map(f=>`<td>${esc(row[f]??'')}</td>`).join('')}<td>${actions}</td></tr>`}).join('')||`<tr><td colspan="${heads.length+1}" class="empty">No CCR complaints yet.</td></tr>`; $('tbody').insertAdjacentHTML('beforeend',`<tr class="summary-total"><th colspan="${heads.length+1}">TOTAL (${tableRows.length} records)</th></tr>`);
 ccrAutoPoll();
}
function ccrCheck(i){const row=(state.records[CCR_REPORT_KEY]||[])[i];if(!row)return;row._checked=row._checked==='Yes'?'No':'Yes';save();renderCCRReport();}
function editCCRRecord(i){const row=(state.records[CCR_REPORT_KEY]||[])[i];if(!row)return;if(!isAdmin())return alert('Only Admin can edit CCR records.');editIndex=i;const heads=reports[CCR_REPORT_KEY].fields; $('reportForm').innerHTML=`<div class="panel"><h3>Edit CCR Complaint</h3><div class="form-grid">${heads.map(f=>`<div class="field"><label>${esc(f)}</label><input data-ccr-edit="${attr(f)}" value="${attr(row[f]||'')}"></div>`).join('')}<div class="field full"><div class="actions"><button class="btn primary" type="button" onclick="saveCCREdit()">✓ Save Changes</button><button class="btn gray" type="button" onclick="editIndex=null;renderCCRReport()">Cancel</button></div></div></div></div>`;}
function saveCCREdit(){if(editIndex===null)return;const row=(state.records[CCR_REPORT_KEY]||[])[editIndex];if(!row)return;document.querySelectorAll('[data-ccr-edit]').forEach(el=>row[el.dataset.ccrEdit]=el.value);row['Reply Subject'] ||= ccrSubject(row);row['Reply Message'] ||= ccrReplyFor(row);save();editIndex=null;renderCCRReport();}
function openCCRGmail(i){const row=(state.records[CCR_REPORT_KEY]||[])[i];const url=ccrGmailUrl(row);if(!url)return alert('Customer Gmail address is not available.');window.open(url,'_blank','noopener');}
function deleteCCRRecord(i){if(!isAdmin())return alert('Only Admin can delete CCR records.');const row=(state.records[CCR_REPORT_KEY]||[])[i];if(!row)return;if(!isAdmin()&&String(row._userId||'')!==String(currentUser?.id||''))return alert('You can delete only your own CCR records.');if(!confirm('Delete this CCR transaction record? It will be moved to Deleted Records and kept until Admin permanently deletes it.'))return;state.deletedRecords ||= [];state.deletedRecords.push({reportKey:CCR_REPORT_KEY,reportName:'CCR Final Summary',record:deepClone(row),deletedBy:currentUser.name||currentUser.id,deletedAt:new Date().toISOString()});state.records[CCR_REPORT_KEY].splice(i,1);save();renderCCRReport();}
function ccrPick(text,patterns){for(const re of patterns){const m=text.match(re);if(m&&m[1])return m[1].trim()}return ''}
function ccrClean(v){return String(v||'').replace(/[\u200b\u200c\u200d]/g,'').replace(/\s{2,}/g,' ').trim()}
function ccrNormalizeDate(v){const s=ccrClean(v);let m=s.match(/\b(\d{1,2})[\/.\-](\d{1,2})[\/.\-](\d{2,4})\b/);if(m){let y=m[3];if(y.length===2)y='20'+y;return `${m[1].padStart(2,'0')}-${m[2].padStart(2,'0')}-${y}`;}m=s.match(/\b(\d{1,2})\s+(Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\s+(\d{4})\b/i);if(m){const months={jan:'01',feb:'02',mar:'03',apr:'04',may:'05',jun:'06',jul:'07',aug:'08',sep:'09',oct:'10',nov:'11',dec:'12'};return `${m[1].padStart(2,'0')}-${months[m[2].slice(0,3).toLowerCase()]}-${m[3]}`;}return ''}
function ccrParseText(text,filename){
 const t=String(text||'').replace(/\r/g,'\n');
 const email=(t.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/ig)||[])[0]||'';
 const app=/super\.?money/i.test(t)?'Super.Money':/google\s*pay|gpay/i.test(t)?'Google Pay':/phonepe/i.test(t)?'PhonePe':/paytm/i.test(t)?'Paytm':/amazon\s*pay/i.test(t)?'Amazon Pay':/bhim/i.test(t)?'BHIM':/mobikwik/i.test(t)?'MobiKwik':/bank|netbanking|internet banking/i.test(t)?'Bank': '';
 const amount=ccrPick(t,[/(?:amount|paid|sent|received|payment)\s*(?:is|of|:)?\s*(?:₹|rs\.?|inr)\s*([0-9,]+(?:\.\d{1,2})?)/i,/(?:₹|rs\.?|inr)\s*([0-9,]+(?:\.\d{1,2})?)/i]);
 const date=ccrNormalizeDate(ccrPick(t,[/(?:date|on)\s*[:\-]?\s*(\d{1,2}[\/.\-]\d{1,2}[\/.\-]\d{2,4})/i,/\b(\d{1,2}[\/.\-]\d{1,2}[\/.\-]\d{2,4})\b/]));
 const time=ccrPick(t,[/(?:time|at)\s*[:\-]?\s*(\d{1,2}:\d{2}\s*(?:am|pm)?)/i,/\b(\d{1,2}:\d{2}\s*(?:am|pm))\b/i]);
 const upi=ccrPick(t,[/(?:upi\s*id|vpa)\s*[:\-]?\s*([A-Za-z0-9._-]+@[A-Za-z0-9.-]+)/i,/\b([A-Za-z0-9._-]{2,}@[A-Za-z0-9.-]{2,})\b/]);
 const utr=ccrPick(t,[/(?:utr|rrn|bank\s*reference(?:\s*number)?|utr\s*number)\s*[:#\-]?\s*([A-Z0-9]{6,30})/i]);
 const upiTxn=ccrPick(t,[/(?:upi\s*(?:transaction|txn)\s*id|upi\s*transaction\s*id)\s*[:#\-]?\s*([A-Z0-9]{6,40})/i]);
 const appTxn=ccrPick(t,[/(?:app\s*transaction\s*id|transaction\s*id|txn\s*id)\s*[:#\-]?\s*([A-Z0-9]{6,50})/i]);
 const ref=ccrPick(t,[/(?:reference\s*(?:id|number|no\.?))\s*[:#\-]?\s*([A-Z0-9]{5,40})/i]);
 const name=ccrPick(t,[/(?:paid\s*to|sent\s*to|received\s*from|recipient|receiver|merchant|beneficiary|name)\s*[:\-]?\s*([A-Za-z][A-Za-z .'-]{2,60})/i]);
 const payment=ccrPick(t,[/(?:payment\s*(?:method|mode)|paid\s*(?:via|from)|debit\s*from|credit\s*from)\s*[:\-]?\s*([^\n]{2,60})/i]);
 let status='';if(/payment\s*(?:was\s*)?successful|transaction\s*successful|successfully\s*paid|completed/i.test(t))status='Success';else if(/payment\s*failed|transaction\s*failed|failed/i.test(t))status='Failed';else if(/payment\s*pending|transaction\s*pending|pending/i.test(t))status='Pending';
 const savedAt=new Date().toISOString(); const row={'Name':ccrClean(name),'Complaint Received Date/Time':savedAt,'Customer Gmail':email,'App':app,'Amount':amount?`₹${amount.replace(/,/g,'')}`:'','Transaction Date/Time':[date,ccrClean(time)].filter(Boolean).join(' '),'UPI ID':ccrClean(upi),'UTR':ccrClean(utr),'UPI Transaction ID':ccrClean(upiTxn),'App Transaction ID':ccrClean(appTxn),'Payment Method':ccrClean(payment),'Transaction Status':status,'Reference ID':ccrClean(ref),'Reply Required':email?'Yes':'No','Reply To Gmail':email,'Reply Subject':'','Reply Message':'','Replied By':'','Reply Date & Time':'','Reply Status':'Not Replied','Resolution Status':'Pending','_userId':currentUser.id,'_userName':currentUser.name,'_savedAt':savedAt,'Source':filename||''};row['Reply Subject']=ccrSubject(row);row['Reply Message']=ccrReplyFor(row);return row;
}
async function processCCRFiles(){if(!ccrPerms(currentUser,'received').add)return alert('Add permission is not granted for Complaint Received.');const input=$('ccrFiles');const files=[...(input?.files||[])];if(!files.length)return alert('Please select one or more screenshots.');if(typeof Tesseract==='undefined')return alert('OCR library is still loading. Please wait a few seconds and try again.');const status=$('ccrOCRStatus');let done=0;for(const file of files){try{status.textContent=`Reading ${done+1} of ${files.length}: ${file.name}`;const result=await Tesseract.recognize(file,'eng',{logger:m=>{if(m.status==='recognizing text'&&m.progress)status.textContent=`Reading ${done+1} of ${files.length}: ${Math.round(m.progress*100)}%`}});const row=ccrParseText(result?.data?.text||'',file.name);row._recordId=`manual-${Date.now()}-${Math.random().toString(36).slice(2,10)}`;row._userId=currentUser.id;row._userName=currentUser.name;row._savedAt=new Date().toISOString();state.records[CCR_REPORT_KEY] ||= [];state.records[CCR_REPORT_KEY].push(row);done++;}catch(e){console.warn('CCR OCR failed',file.name,e);}}if(done){state.activities.push(`CCR processed ${done} screenshot${done>1?'s':''} by ${currentUser.name}`);save();renderCCRReport();}status.textContent=`Completed: ${done} of ${files.length} screenshot${files.length>1?'s':''}.`;if(input)input.value='';}

function renderNav(){
 const masterWasOpen=!!document.querySelector('#masterSub:not(.hidden)');
 const ccrWasOpen=!!document.querySelector('#ccrSub:not(.hidden)');
 const agentWasOpen=!!document.querySelector('#agentSub:not(.hidden)');
 const reportsWasOpen=!!document.querySelector('#reportsSub:not(.hidden)');
 let h=`<a onclick="showDashboard()">⌂ <span>Main Dashboard</span></a>`;
 const masterMenu=`<div class="master-block"><button type="button" class="master-toggle" onclick="toggleMasterMenu()">◉ <span>NMRC Master Management</span><em id="masterArrow">⌄</em></button><div id="masterSub" class="master-sub${masterWasOpen?'':' hidden'}"><a onclick="showUsers()">♟ <span>User Management</span></a><a onclick="showUsers(true)">＋ <span>User Creation</span></a><a onclick="showStations()">▣ <span>Station Name</span></a><a onclick="showEquipmentMaster()">▤ <span>Equipment Master</span></a><a onclick="showComponentMaster()">⚙ <span>Component Master</span></a><a onclick="showMasterImport()">⇩ <span>Master Import</span></a><a onclick="showAgentEntryMaster()">⌑ <span>Agent Entry Master</span></a></div></div>`;
 const agentItems=STATIC_ROLES.filter(x=>['station','pm','failure','material','inventory','addinventory'].includes(x[0])).filter(([k])=>permsFor(currentUser,k).view).map(([k,n])=>`<a onclick="openReport('${k}')">▦ <span>${esc(n)}</span></a>`).join('');
 const agentMenu=`<div class="master-block"><button type="button" class="master-toggle" onclick="toggleAgentMenu()">▤ <span>Agent Inventory</span><em id="agentArrow">⌄</em></button><div id="agentSub" class="master-sub${agentWasOpen?'':' hidden'}">${agentItems}</div></div>`;
 const ccrMenu=`<div class="master-block ccr-nav-block"><button type="button" class="master-toggle" onclick="toggleCCRMenu()">▦ <span>CCR Management</span><em id="ccrArrow">⌄</em></button><div id="ccrSub" class="master-sub${ccrWasOpen?'':' hidden'}">${ccrPerms(currentUser,'management').view?'<a onclick="openCCRView(\'main\')">▦ <span>CCR Dashboard</span></a>':''}${ccrPerms(currentUser,'received').view?'<a onclick="openCCRView(\'received\')">▤ <span>Complaint Receive</span></a>':''}${ccrPerms(currentUser,'status').view?'<a onclick="openCCRView(\'reply\')">✉ <span>Complaint Reply</span></a>':''}${ccrPerms(currentUser,'status').view?'<a onclick="openCCRView(\'status\')">▥ <span>Pending Status</span></a>':''}${ccrPerms(currentUser,'final').view?'<a onclick="openCCRView(\'final\')">▤ <span>Final Summary</span></a>':''}</div></div>`;
 const reportMenu=`<div class="master-block"><button type="button" class="master-toggle" onclick="toggleReportsMenu()">▥ <span>Reports</span><em id="reportsArrow">⌄</em></button><div id="reportsSub" class="master-sub${reportsWasOpen?'':' hidden'}">${permsFor(currentUser,'summary').view?'<a onclick="openReport(\'summary\')">▥ <span>Final Summary</span></a>':''}${permsFor(currentUser,'location').view?'<a onclick="showLocation()">⌖ <span>Agent Location History</span></a>':''}${isAdmin()?'<a onclick="showSettings()">⚙ <span>Theme Settings &amp; Backup</span></a>':''}${isAdmin()?'<a onclick="showDeletedRecords()">♻ <span>Deleted Records</span></a>':''}</div></div>`;
 h+=masterMenu+agentMenu;if(isCCRUser())h+=ccrMenu;h+=reportMenu;
 $('nav').innerHTML=h;
}
function toggleMasterMenu(){const sub=$('masterSub');if(!sub)return;const isHidden=sub.classList.contains('hidden');sub.classList.toggle('hidden',!isHidden);const a=$('masterArrow');if(a)a.textContent=isHidden?'⌃':'⌄'}
function toggleAgentMenu(){const sub=$('agentSub');if(!sub)return;const isHidden=sub.classList.contains('hidden');sub.classList.toggle('hidden',!isHidden);const a=$('agentArrow');if(a)a.textContent=isHidden?'⌃':'⌄'}
function toggleReportsMenu(){const sub=$('reportsSub');if(!sub)return;const isHidden=sub.classList.contains('hidden');sub.classList.toggle('hidden',!isHidden);const a=$('reportsArrow');if(a)a.textContent=isHidden?'⌃':'⌄'}


function toggleMasterMenu(){const sub=$('masterSub');if(!sub)return;const isHidden=sub.classList.contains('hidden');sub.classList.toggle('hidden',!isHidden);const a=$('masterArrow');if(a)a.textContent=isHidden?'⌃':'⌄'}
function showPage(id){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));const page=$(id);if(page)page.classList.add('active')}
function showDashboard(){showPage('dashboard');closeSidebar();renderDashboard()}
function openReport(k){if(!reports[k]||!permsFor(currentUser,k).view){alert('You do not have View permission for this report.');return}if(k===CCR_REPORT_KEY)ccrView='main';current=k;editIndex=null;showPage('report');closeSidebar();$('reportTitle').textContent=reports[k].title;$('reportDesc').textContent='Responsive report • Add / Edit / Delete / Excel / PDF';renderReport()}
function showMasterImport(){if(!isAdmin())return;showPage('masterImport');closeSidebar();}
function importMasterFile(){if(!isAdmin())return;const f=$('masterImportFile')?.files?.[0];if(!f)return alert('Select an Excel or CSV file.');parseFile(f,rows=>{let stations=0,equipment=0,components=0;const stationSet=new Set((state.stations||[]).map(x=>String(x).toLowerCase()));const eqSet=new Set((state.equipmentMaster||[]).map(x=>`${x.type}|${x.name}|${x.number}`.toLowerCase()));const compSet=new Set((state.componentMaster||[]).map(x=>String(x).toLowerCase()));rows.forEach(raw=>{const keys=Object.keys(raw);const get=(name)=>{const h=keys.find(k=>k.trim().toLowerCase()===name.toLowerCase());return h?String(raw[h]??'').trim():''};const station=get('STATION')||get('Station Name');if(station&&!stationSet.has(station.toLowerCase())){state.stations.push(station);stationSet.add(station.toLowerCase());state.deletedStations=(state.deletedStations||[]).filter(x=>String(x).toLowerCase()!==station.toLowerCase());stations++}
const type=get('EQUIPMENT TYPE')||get('Equipment Type')||get('System');const name=get('EQUIPMENT NAME')||get('Equipment Name');const number=get('EQUIPMENT NUMBER')||get('Equipment Number');if(type&&name){const key=`${type}|${name}|${number}`.toLowerCase();if(!eqSet.has(key)){state.equipmentMaster.push({type,name,number});eqSet.add(key);state.deletedEquipmentMaster=(state.deletedEquipmentMaster||[]).filter(x=>x.toLowerCase()!==key);equipment++}}
COMPONENT_MASTER.forEach(c=>{const hit=keys.find(k=>k.trim().toLowerCase()===c.toLowerCase());if(hit&&!compSet.has(c.toLowerCase())){state.componentMaster.push(c);compSet.add(c.toLowerCase());state.deletedComponents=(state.deletedComponents||[]).filter(x=>String(x).toLowerCase()!==c.toLowerCase());components++}});
// Treat any additional component-style columns from the workbook as Component Master values only when explicitly present as headers.
keys.forEach(h=>{const hn=h.trim();if(/^gv7 mb$|^processor$|^display driver board$|^sensor cable$|^proximity sensor$|^mib board$|^feig faulty$|^slave side\(bidi\) flap damage$|^pcm board faulty$|^flap damage$|^display$|^qr scanner$|^qr glass$|^gv sticker$|^smps$|^lamp$|^buzzer$|^mother board$|^comm cable$|^ag sensor$|^magnetic plate$/i.test(hn)&&!compSet.has(hn.toLowerCase())){state.componentMaster.push(hn);compSet.add(hn.toLowerCase());state.deletedComponents=(state.deletedComponents||[]).filter(x=>String(x).toLowerCase()!==hn.toLowerCase());components++}})});
// Always keep the approved four AG equipment names available in Equipment Master.
DEFAULT_EQUIPMENT_NAMES.forEach(name=>{const key=`AG|${name}|`.toLowerCase();if(!eqSet.has(key)&&!(state.deletedEquipmentMaster||[]).some(x=>x.toLowerCase()===key)){state.equipmentMaster.push({type:'AG',name,number:''});eqSet.add(key);equipment++}});
state.activities.push(`Admin Master Import: ${stations} stations, ${equipment} equipment, ${components} components`);save();renderStations();renderEquipmentMaster();renderComponentMaster();renderNav();$('masterImportStatus').textContent=`Imported to Master only: ${stations} stations, ${equipment} equipment, ${components} components. No report records were created.`;alert(`Master import completed.\n\nStations: ${stations}\nEquipment: ${equipment}\nComponents: ${components}\n\nNo AG Inspection/report rows were created.`);});$('masterImportFile').value=''}
function showAgentEntryMaster(){if(!isAdmin())return;showPage('agentEntryMaster');closeSidebar();const b=$('agentEntryMasterBody');if(b)b.innerHTML=STATIC_ROLES.filter(x=>['station','pm','failure','material','inventory','addinventory'].includes(x[0])).map(([k,n])=>`<tr><td>${esc(n)}</td><td>${esc(reports[k]?.fields?.join(' • ')||'')}</td><td><button class="btn primary small-btn" onclick="openReport('${k}')">Open Report</button></td></tr>`).join('');}
function showDeletedRecords(){if(!isAdmin())return;showPage('deletedRecords');closeSidebar();renderDeletedRecords()}
function renderDeletedRecords(){if(!isAdmin())return;state.deletedRecords ||= [];const b=$('deletedBody');b.innerHTML=state.deletedRecords.map((x,i)=>{const rid=x.record?.id||x.record?._id||x.record?.['Reference ID']||x.record?.['Serial Number']||i+1;return `<tr><td>${esc(x.reportName||x.reportKey)}</td><td>${esc(x.deletedBy||'')}</td><td>${esc(x.deletedAt?new Date(x.deletedAt).toLocaleString():'')}</td><td>${esc(rid)}</td><td><button class="btn gray small-btn" onclick="restoreDeleted(${i})">Restore</button> <button class="btn danger small-btn" onclick="permanentDeleteDeleted(${i})">Permanent Delete</button></td></tr>`}).join('')||'<tr><td colspan="5" class="empty">No deleted records.</td></tr>'}
function restoreDeleted(i){if(!isAdmin())return;const x=(state.deletedRecords||[])[i];if(!x)return;if(!confirm('Restore this record to its original report?'))return;state.records[x.reportKey] ||= [];state.records[x.reportKey].push(deepClone(x.record));state.deletedRecords.splice(i,1);save();renderDeletedRecords();renderDashboard()}
async function permanentDeleteDeleted(i){if(!isAdmin())return;const x=(state.deletedRecords||[])[i];if(!x)return;if(!confirm('Permanently delete this archived record? This cannot be undone.'))return; const backupState=deepClone(state); backupState.deletedRecords=[...(backupState.deletedRecords||[])].filter((_,idx)=>idx!==i); backupState.permanentDeletionArchive=[...(backupState.permanentDeletionArchive||[]),{...deepClone(x),permanentlyDeletedAt:new Date().toISOString()}]; backupState.permanentDeletedRecordKeys=[...(backupState.permanentDeletedRecordKeys||[]),String(x.recordKey||recordKey(x.reportKey,x.record))]; try{if(LIVE_SYNC_CONFIG.apiBase){const r=await fetch((LIVE_SYNC_CONFIG.apiBase||'/api')+'/drive-backup',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({backupUrl:LIVE_SYNC_CONFIG.driveBackupUrl||'',filename:'NMRC_INVENTORY_BACKUP.xlsx',sheetName:'NMRC_INVENTORY_BACKUP',sheets:driveBackupSheets(),deletedFolder:'NMRC_INVENTORY_DELETED',deletedRecords:[x],state:backupState,updatedAt:new Date().toISOString()})});if(!r.ok)throw new Error('Google Drive backup failed before permanent deletion');} }catch(e){alert(e.message||'Google Drive backup failed. Permanent deletion was not completed.');return} state.deletedRecords.splice(i,1);save();renderDeletedRecords()}
function exportDeletedExcel(){if(!isAdmin())return;downloadWorkbook([{name:'Deleted Records',rows:(state.deletedRecords||[]).map(x=>({Report:x.reportName,DeletedBy:x.deletedBy,DeletedAt:x.deletedAt,Record:JSON.stringify(x.record)}))}],'NMRC_Deleted_Records.xlsx')}
function printDeleted(){if(!isAdmin())return;const rows=(state.deletedRecords||[]).map(x=>[x.reportName,x.deletedBy,x.deletedAt,JSON.stringify(x.record)]);printTable('Deleted Records',['Report','Deleted By','Deleted Date/Time','Record'],rows)}
function showLocation(){showPage('location');closeSidebar();renderLocation()}
function showImporter(){if(!isAdmin()){alert('Only Admin can import data.');return}showPage('importer');closeSidebar();populateImportTargets()}
function showUsers(form=false){if(!isAdmin())return;closeSidebar();if(form){showPage('userCreation');if($('userCreationForm'))$('userCreationForm').innerHTML='';renderUserForm(null);return}showPage('users');if($('userCreationForm'))$('userCreationForm').innerHTML='';renderUsers()}
function showStations(){if(!isAdmin())return;showPage('stations');closeSidebar();renderStations()}
function renderStations(){const list=state.stations||[];$('stationList').innerHTML=list.length?list.map((n,i)=>`<div class="station-row"><b>${esc(n)}</b><div class="station-actions"><button class="btn" type="button" onclick="editStation(${i})">Edit</button><button class="btn danger" type="button" onclick="deleteStation(${i})">Delete</button></div></div>`).join(''):'<div class="empty">No stations added yet.</div>'}
function addStation(event){event.preventDefault();const input=$('newStationName'),n=input.value.trim();if(!n)return;if((state.stations||[]).some(x=>x.toLowerCase()===n.toLowerCase()))return alert('Station already exists.');state.deletedStations=(state.deletedStations||[]).filter(x=>String(x).toLowerCase()!==n.toLowerCase());state.stations.push(n);save();input.value='';renderStations();renderNav()}
function editStation(i){const old=String((state.stations||[])[i]||'');if(!old)return;const next=prompt('Edit station name?',old);if(next===null)return;const n=next.trim();if(!n)return alert('Station name cannot be empty.');if((state.stations||[]).some((x,idx)=>idx!==i&&x.toLowerCase()===n.toLowerCase()))return alert('Station already exists.');state.stations[i]=n;save();renderStations();renderNav()}
function deleteStation(i){if(!confirm('Delete this station?'))return;const v=String(state.stations[i]||'');state.deletedStations ||= [];if(v&&!state.deletedStations.includes(v))state.deletedStations.push(v);state.stations.splice(i,1);save();renderStations();renderNav()}
function showComponentMaster(){if(!isAdmin())return;showPage('componentMaster');closeSidebar();renderComponentMaster()}
function renderComponentMaster(){const list=state.componentMaster||[];const b=$('componentMasterBody');if(!b)return;b.innerHTML=list.map((x,i)=>`<tr><td>${i+1}</td><td>${esc(x)}</td><td><button class="btn small-btn" type="button" onclick="editComponentMaster(${i})">Edit</button> <button class="btn danger small-btn" type="button" onclick="deleteComponentMaster(${i})">Delete</button></td></tr>`).join('')||'<tr><td colspan="3" class="empty">No components in Master.</td></tr>'}
function addComponentMaster(event){event.preventDefault();if(!isAdmin())return;const input=$('newComponentName'),n=input.value.trim();if(!n)return;if((state.componentMaster||[]).some(x=>String(x).toLowerCase()===n.toLowerCase()))return alert('Component already exists.');state.componentMaster.push(n);save();input.value='';renderComponentMaster()}
function editComponentMaster(i){if(!isAdmin())return;const old=String((state.componentMaster||[])[i]||'');if(!old)return;const next=prompt('Edit component name?',old);if(next===null)return;const n=next.trim();if(!n)return alert('Component name cannot be empty.');if((state.componentMaster||[]).some((x,idx)=>idx!==i&&String(x).toLowerCase()===n.toLowerCase()))return alert('Component already exists.');state.componentMaster[i]=n;save();renderComponentMaster()}
function deleteComponentMaster(i){if(!isAdmin())return;const x=state.componentMaster?.[i];if(!x)return;if(!confirm('Delete this component from Master? Existing records will keep their saved values.'))return;state.componentMaster.splice(i,1);save();renderComponentMaster()}
function componentOptions(v){const list=state.componentMaster||COMPONENT_MASTER;const cur=String(v??'');return `<option value="">Select Component / Part</option>${list.map(x=>`<option value="${attr(x)}" ${x===cur?'selected':''}>${esc(x)}</option>`).join('')}`}
function showEquipmentMaster(){if(!isAdmin())return;showPage('equipmentMaster');closeSidebar();renderEquipmentMaster()}
function renderEquipmentMaster(){const list=state.equipmentMaster||[];$('equipmentMasterBody').innerHTML=list.length?list.map((x,i)=>`<tr><td>${esc(x.type)}</td><td>${esc(x.name)}</td><td>${esc(x.number||'')}</td><td><button class="btn small-btn" type="button" onclick="editEquipmentMaster(${i})">Edit</button> <button class="btn danger small-btn" type="button" onclick="deleteEquipmentMaster(${i})">Delete</button></td></tr>`).join(''):'<tr><td colspan="4" class="empty">No equipment added yet.</td></tr>'}
function addEquipmentMaster(event){event.preventDefault();const type=$('newEquipmentType').value.trim(),name=$('newEquipmentName').value.trim(),number=$('newEquipmentNumber').value.trim();if(!type||!name||!number)return;if((state.equipmentMaster||[]).some(x=>x.type.toLowerCase()===type.toLowerCase()&&x.name.toLowerCase()===name.toLowerCase()&&String(x.number||'').toLowerCase()===number.toLowerCase()))return alert('Equipment Type, Equipment Name and Equipment Number already exists.');const ek=`${type}|${name}|${number}`;state.deletedEquipmentMaster=(state.deletedEquipmentMaster||[]).filter(x=>x!==ek);state.equipmentMaster.push({type,name,number});save();$('newEquipmentType').value='';$('newEquipmentName').value='';$('newEquipmentNumber').value='';renderEquipmentMaster();}
function editEquipmentMaster(i){const x=state.equipmentMaster[i];if(!x)return;const form=$('equipmentEditForm');if(!form)return;form.innerHTML=`<h3>Edit Equipment Master</h3><form class="form-grid" onsubmit="saveEquipmentMasterEdit(event,${i})"><div class="field"><label>Equipment Type *</label><input id="editEquipmentType" required value="${attr(x.type||'')}" placeholder="Enter equipment type"></div><div class="field"><label>Equipment Name *</label><input id="editEquipmentName" required value="${attr(x.name||'')}" placeholder="Enter equipment name"></div><div class="field"><label>Equipment Number *</label><input id="editEquipmentNumber" required value="${attr(x.number||'')}" placeholder="Enter equipment number"></div><div class="field full"><div class="modal-actions"><button class="btn gray" type="button" onclick="closeEquipmentEdit()">Cancel</button><button class="btn primary" type="submit">Save Update</button></div></div></form>`;$('equipmentEditModal').classList.remove('hidden');setTimeout(()=>{const el=$('editEquipmentType');if(el){el.focus();el.select()}},0)}
function closeEquipmentEdit(){const m=$('equipmentEditModal');if(m)m.classList.add('hidden')}
function saveEquipmentMasterEdit(event,i){event.preventDefault();const t=$('editEquipmentType').value.trim(),n=$('editEquipmentName').value.trim(),num=$('editEquipmentNumber').value.trim();if(!t||!n||!num)return alert('All three fields are required.');if(state.equipmentMaster.some((e,idx)=>idx!==i&&e.type.toLowerCase()===t.toLowerCase()&&e.name.toLowerCase()===n.toLowerCase()&&String(e.number||'').toLowerCase()===num.toLowerCase()))return alert('Equipment Type, Equipment Name and Equipment Number already exists.');state.equipmentMaster[i]={type:t,name:n,number:num};save();closeEquipmentEdit();renderEquipmentMaster();}
function deleteEquipmentMaster(i){if(!confirm('Delete this equipment master entry?'))return;const x=state.equipmentMaster[i];if(!x)return;state.deletedEquipmentMaster ||= [];const key=`${x.type||''}|${x.name||''}|${x.number||''}`;if(!state.deletedEquipmentMaster.includes(key))state.deletedEquipmentMaster.push(key);state.equipmentMaster.splice(i,1);save();renderEquipmentMaster()}
function uniqueReportValues(field,defaults=[]){const vals=[...defaults];Object.values(state.records||{}).forEach(arr=>(arr||[]).forEach(r=>{const v=String(r?.[field]??'').trim();if(v&&!vals.some(x=>x.toLowerCase()===v.toLowerCase()))vals.push(v)}));return vals}
function stationOptions(value){const list=[...new Set([...(state.stations||[]),...uniqueReportValues('Station Name'),...uniqueReportValues('STATION')])];return `<option value="">Select Station</option>${list.map(x=>`<option value="${attr(x)}" ${String(value??'')===x?'selected':''}>${esc(x)}</option>`).join('')}`}
function selectOptions(label,values,value){const cur=String(value??'');if(cur&&!values.some(x=>x.toLowerCase()===cur.toLowerCase()))values=[cur,...values];return `<option value="">Select ${esc(label)}</option>${values.map(x=>`<option value="${attr(x)}" ${x===cur?'selected':''}>${esc(x)}</option>`).join('')}`}
function showBuilder(){if(!isAdmin())return;showPage('builder');closeSidebar();renderBuilder()}
function showSettings(){showPage('settings');closeSidebar();setHeader()}
function renderDashboard(){const vals=[['⚠ Failure Today',0,'red'],['✓ Resolved Today',0,'green'],['◷ Pending Today',0,'orange'],['◇ Damage Case Till Now',0,'blue'],['⌕ Inspection Stations Today',0,'cyan'],['▣ Available DR Roll',0,'indigo'],['▤ Available Wax Roll',0,'teal'],['▤ Available Receipt Roll',0,'purple'],['▧ Today TVM Roll Issue',0,'teal'],['▧ Today Wax Roll Issue',0,'red'],['▧ Today Receipt Roll Issue',0,'darkteal'],['▧ Today DR Roll Issue',0,'blue']];$('cards').innerHTML=vals.map(v=>`<div class="card ${v[2]}"><b>${v[0]}</b><strong>0</strong><small>Tap to view details →</small></div>`).join('');$('activities').innerHTML='<p>🟢 Portal ready - no activity yet</p>'}
function summaryRows(){const rows=[];Object.keys(reports).filter(k=>k!=='summary'&&k!=='location'&&k!=='ccr').forEach(k=>(state.records[k]||[]).forEach((x,idx)=>{const isFail=k==='failure';const date=x.Date||x.date||new Date(x._savedAt||Date.now()).toISOString().slice(0,10);rows.push({...x,'Date':date,'Date & Time':x['Date & Time']||(x._savedAt?new Date(x._savedAt).toLocaleString():''),'Agent':x.Agent||x.agent||x._userName||'','Employee ID / User Name':x['Employee ID / User Name']||x._userId||'','Station':x.Station||x['Station Name']||x.station||'','System':x.System||'Automatic Gate','Sub System':x['Sub System']||x['SUB SYSTEM']||'','Equipment Name':x['Equipment Name']||'','Status':x.Status||x['G7 Status']||'','Latitude':x._lat??x.Latitude??'','Longitude':x._lng??x.Longitude??'','Map URL':x._map||x['Map URL']||'','Entry Photo':x._photo||x['Entry Photo']||'','Failure Count':isFail?1:'','L1 Faulty':isFail&&/fault|fail|yes|1/i.test(String(x.L1||''))?1:'','PCR Faulty':isFail&&/fault|fail|yes|1/i.test(String(x.PCR||''))?1:'','D1 Faulty':isFail&&/fault|fail|yes|1/i.test(String(x.D1||''))?1:'','Material Quantity':x.Quantity||x['Added Quantity']||'','Inventory Closing':x.Closing||'','Remarks':x.Remarks||x.Remark||'',_source:k,_sourceIndex:idx});}));return rows}
function summaryFieldList(rows){const base=[...reports.summary.fields];const seen=new Set(base);rows.forEach(x=>Object.keys(x).forEach(k=>{if(!k.startsWith('_')&&!seen.has(k)&&k!=='Reply Message'&&k!=='Customer Gmail'){seen.add(k);base.push(k)}}));return base}
function getGenericFilteredRows(rows){
 const from=$('repFrom')?.value||'',to=$('repTo')?.value||'',agent=($('repAgent')?.value||'').toLowerCase(),station=($('repStation')?.value||'').toLowerCase(),status=($('repStatus')?.value||'').toLowerCase(),q=($('repSearch')?.value||'').toLowerCase();
 return rows.map((row,i)=>({...row,__index:i})).filter(row=>{
   const dateText=String(row.Date||row['Date & Time']||row['Complaint Received Date/Time']||row['Transaction Date/Time']||'').slice(0,10);
   const hay=Object.values(row).filter(v=>v!==undefined&&v!==null).join(' ').toLowerCase();
   return (!from||dateText>=from)&&(!to||dateText<=to)&&(!agent||String(row.Agent||row.Name||row['Employee Name']||'').toLowerCase().includes(agent))&&(!station||String(row.Station||row['Station Name']||'').toLowerCase().includes(station))&&(!status||String(row.Status||row['Reply Status']||row['Resolution Status']||'').toLowerCase()===status)&&(!q||hay.includes(q));
 });
}
function renderReport(){
 if(current===CCR_REPORT_KEY){renderCCRReport();return}
 if(!reports[current]||!permsFor(currentUser,current).view)return;
 const r=reports[current],p=permsFor(currentUser,current);let sourceRows=current==='summary'?summaryRows():(state.records[current]||[]);if(current==='summary')r.fields=summaryFieldList(sourceRows);
 const oldFilter=window.__reportFilterState?.[current]||{}; if(current!=='summary'){window.__reportFilterState ||= {}; window.__reportFilterState[current]={from:$('repFrom')?.value||oldFilter.from||'',to:$('repTo')?.value||oldFilter.to||'',agent:$('repAgent')?.value||oldFilter.agent||'',station:$('repStation')?.value||oldFilter.station||'',status:$('repStatus')?.value||oldFilter.status||'',search:$('repSearch')?.value||oldFilter.search||''};}
 let buttons='';if(p.add&&current!=='summary')buttons+=`<button class="btn primary" onclick="addRecord()">＋ Add Entry</button>`;if(isAdmin()){if(p.view&&p.edit)buttons+=`<button class="btn gray" onclick="editSelectedReport()">Edit</button>`;if(p.view&&p.delete)buttons+=`<button class="btn danger" onclick="deleteSelectedReport()">Delete</button>`;if(p.view)buttons+=`<button class="btn gray" onclick="exportExcel('${current}')">Export Excel</button><button class="btn gray" onclick="exportPDF('${current}')">Export PDF</button>`;}
 $('reportActions').innerHTML=buttons;$('reportTitle').textContent=r.title;$('reportDesc').textContent=isAdmin()?'Admin report view • Filters • Totals • Export Excel • Export PDF':'Entry form only';
 if(!isAdmin()){
   $('reportForm').innerHTML='<div class="muted" style="margin:12px 0">Entry form only. Saved entries and totals are available to Admin in Final Summary.</div>';
   if($('thead'))$('thead').innerHTML=''; if($('tbody'))$('tbody').innerHTML='';
   return;
 }
if(current==='summary'){
   $('reportForm').innerHTML=`<div class="summary-filters panel"><div class="form-grid"><div class="field"><label>From Date</label><input id="sumFrom" type="date" onchange="applySummaryFilter()"></div><div class="field"><label>To Date</label><input id="sumTo" type="date" onchange="applySummaryFilter()"></div><div class="field"><label>Agent</label><select id="sumAgent" onchange="applySummaryFilter()"><option value="">All Agents</option>${[...new Set(sourceRows.map(x=>x.Agent).filter(Boolean))].sort().map(a=>`<option>${esc(a)}</option>`).join('')}</select></div><div class="field"><label>Report</label><select id="sumReport" onchange="applySummaryFilter()"><option value="">All Reports</option>${[...new Set(sourceRows.map(x=>x._source).filter(Boolean))].map(k=>`<option value="${attr(k)}">${esc(roleLabel(k))}</option>`).join('')}</select></div><div class="field full"><div class="actions"><button class="btn gray" type="button" onclick="resetSummaryFilter()">Reset Filter</button><span id="summaryCount" class="user-count">0 entries</span></div></div></div></div>`;
   renderReportRows(sourceRows.map((x,i)=>({...x,__index:i})));
   return;
 }
 const displayRows=getGenericFilteredRows(sourceRows);
 const values=sourceRows.map(x=>x.Agent||x.Name||x['Employee Name']).filter(Boolean);const stations=sourceRows.map(x=>x.Station||x['Station Name']).filter(Boolean);const statuses=sourceRows.map(x=>x.Status||x['Reply Status']||x['Resolution Status']).filter(Boolean);
 $('reportForm').innerHTML=`<div class="panel report-filters"><div class="form-grid"><div class="field"><label>From Date</label><input id="repFrom" type="date" onchange="renderReport()"></div><div class="field"><label>To Date</label><input id="repTo" type="date" onchange="renderReport()"></div><div class="field"><label>Agent</label><select id="repAgent" onchange="renderReport()"><option value="">All Agents</option>${[...new Set(values)].sort().map(v=>`<option>${esc(v)}</option>`).join('')}</select></div><div class="field"><label>Station</label><select id="repStation" onchange="renderReport()"><option value="">All Stations</option>${[...new Set(stations)].sort().map(v=>`<option>${esc(v)}</option>`).join('')}</select></div><div class="field"><label>Status</label><select id="repStatus" onchange="renderReport()"><option value="">All Status</option>${[...new Set(statuses)].sort().map(v=>`<option>${esc(v)}</option>`).join('')}</select></div><div class="field"><label>Search</label><input id="repSearch" placeholder="Search report data" oninput="renderReport()"></div><div class="field full"><div class="actions"><button class="btn gray" type="button" onclick="clearReportFilters()">Reset Filter</button><span class="user-count">${displayRows.length} records</span></div></div></div></div>`;
 // restore filter values after the DOM is rebuilt
 const prev=window.__reportFilterState?.[current]||{};if(prev.from)$('repFrom').value=prev.from;if(prev.to)$('repTo').value=prev.to;if(prev.agent)$('repAgent').value=prev.agent;if(prev.station)$('repStation').value=prev.station;if(prev.status)$('repStatus').value=prev.status;if(prev.search)$('repSearch').value=prev.search;
 const filtered=getGenericFilteredRows(sourceRows);window.__reportFilterState ||= {};window.__reportFilterState[current]={from:$('repFrom')?.value||'',to:$('repTo')?.value||'',agent:$('repAgent')?.value||'',station:$('repStation')?.value||'',status:$('repStatus')?.value||'',search:$('repSearch')?.value||''};
 $('thead').innerHTML='<tr><th>Select</th>'+r.fields.map(f=>`<th>${esc(f)}</th>`).join('')+'<th>Actions</th></tr>';renderReportRows(filtered)
}
function clearReportFilters(){if(window.__reportFilterState)delete window.__reportFilterState[current];renderReport()}
function renderReportRows(rows){const r=reports[current],p=permsFor(currentUser,current);let html=rows.map((row,i)=>{const realIndex=row.__index??i;return `<tr><td><input type="radio" name="reportSelected" value="${realIndex}"></td>${r.fields.map(f=>{const v=row[f]??'';if(f==='Map URL'&&v)return `<td><a href="${attr(v)}" target="_blank" rel="noopener">Open Map</a></td>`;if(f==='Entry Photo'&&v)return `<td><img class="user-thumb" src="${attr(v)}"></td>`;return `<td>${esc(v)}</td>`}).join('')}<td>${isAdmin()?(current==='summary'?`<button class="btn gray small-btn" onclick="editSummaryRecord(${realIndex})">Edit</button> <button class="btn danger small-btn" onclick="deleteRecord(${realIndex})">Delete</button>`:`<button class="btn gray small-btn" onclick="editRecord(${realIndex})">Edit</button> <button class="btn danger small-btn" onclick="deleteRecord(${realIndex})">Delete</button>`):''}</td></tr>`}).join('');
 const nums=r.fields.filter(f=>rows.some(x=>String(x[f]??'').trim()!==''&&Number(String(x[f]).replace(/,/g,''))!==NaN)).filter(f=>rows.some(x=>{const n=Number(String(x[f]??'').replace(/,/g,''));return Number.isFinite(n)&&String(x[f]??'').trim()!==''}));const totals={};nums.forEach(f=>totals[f]=rows.reduce((n,x)=>n+(Number(String(x[f]??'').replace(/,/g,''))||0),0));if(current==='summary'||rows.length){html+=`<tr class="summary-total"><th colspan="2">TOTAL (${rows.length} records)</th>${r.fields.map(f=>`<th>${nums.includes(f)&&totals[f]!==0?esc(totals[f]):''}</th>`).join('')}<th></th></tr>`;}
 $('tbody').innerHTML=html||`<tr><td colspan="${r.fields.length+2}" class="empty">No records yet.</td></tr>`;if(current==='summary'&&$('summaryCount'))$('summaryCount').textContent=`${rows.length} entries`}

function selectedReportIndex(){const x=document.querySelector('input[name="reportSelected"]:checked');return x?Number(x.value):null}
function editSelectedReport(){const i=selectedReportIndex();if(i===null)return alert('Please select a row first.');if(current==='summary')return editSummaryRecord(i);return editRecord(i)}
function deleteSelectedReport(){const i=selectedReportIndex();if(i===null)return alert('Please select a row first.');return deleteRecord(i)}
function editSummaryRecord(i){const row=summaryRows()[i];if(!row||!row._source)return;const k=row._source;if(!isAdmin()){alert('Only Admin can edit report records.');return}current=k;editIndex=row._sourceIndex;showPage('report');closeSidebar();renderReport()}
function applySummaryFilter(){let rows=summaryRows();const from=$('sumFrom')?.value,to=$('sumTo')?.value,agent=$('sumAgent')?.value,rep=$('sumReport')?.value;rows=rows.filter(x=>{const raw=String(x['Date & Time']||x.Date||'');const d=raw.slice(0,10);return (!from||d>=from)&&(!to||d<=to)&&(!agent||x.Agent===agent)&&(!rep||x._source===rep)});renderReportRows(rows)}
function resetSummaryFilter(){['sumFrom','sumTo'].forEach(id=>{if($(id))$(id).value=''});if($('sumAgent'))$('sumAgent').value='';if($('sumReport'))$('sumReport').value='';renderReportRows(summaryRows())}
function addRecord(){if(current==='summary'){alert('Final Summary is generated automatically from report entries.');return}if(!permsFor(currentUser,current).add){alert('Add permission is not granted.');return}editIndex=null;renderRecordForm({})}
function openNativePicker(btn){const input=btn.previousElementSibling;if(!input)return;try{if(typeof input.showPicker==='function')input.showPicker();else input.focus()}catch(e){input.focus()}}
function uniqueValues(field){const vals=new Set();Object.values(state.records||{}).forEach(rows=>(rows||[]).forEach(x=>{const v=String(x?.[field]??'').trim();if(v)vals.add(v)}));return [...vals].sort((a,b)=>a.localeCompare(b));}
function stationEquipmentTypeOptions(v){const vals=[...new Set([...DEFAULT_EQUIPMENT_TYPES,...(state.equipmentMaster||[]).map(x=>x.type).filter(Boolean),...uniqueReportValues('Equipment Type'),...uniqueReportValues('EQUIPMENT TYPE')])];const cur=String(v??'');if(cur&&!vals.includes(cur))vals.unshift(cur);return `<option value="">Select Equipment Type</option>${vals.map(x=>`<option value="${attr(x)}" ${x===cur?'selected':''}>${esc(x)}</option>`).join('')}`}
function stationEquipmentNameOptions(v,type){const all=(state.equipmentMaster||[]).filter(x=>x&&x.name).filter(x=>!type||String(x.type||'')===String(type));let vals=[...new Set(all.map(x=>String(x.name).trim()).filter(Boolean))];if(!vals.length){uniqueReportValues('Equipment Name').forEach(x=>{if(!vals.includes(x))vals.push(x)});uniqueReportValues('EQUIPMENT NAME').forEach(x=>{if(!vals.includes(x))vals.push(x)})}const cur=String(v??'');if(cur&&!vals.includes(cur))vals.unshift(cur);return `<option value="">Select Equipment Name</option>${[...new Set(vals)].map(x=>`<option value="${attr(x)}" ${x===cur?'selected':''}>${esc(x)}</option>`).join('')}`}
function stationEquipmentNumberOptions(v,type,name){let vals=[...DEFAULT_EQUIPMENT_NUMBERS];vals.push(...(state.equipmentMaster||[]).filter(x=>x&&x.number).filter(x=>!type||String(x.type||'')===String(type)).filter(x=>!name||String(x.name||'')===String(name)).map(x=>String(x.number).trim()).filter(Boolean));uniqueReportValues('Equipment Number').forEach(x=>{if(!vals.includes(x))vals.push(x)});uniqueReportValues('EQUIPMENT NUMBER').forEach(x=>{if(!vals.includes(x))vals.push(x)});const cur=String(v??'');if(cur&&!vals.includes(cur))vals.unshift(cur);return `<option value="">Select Equipment Number</option>${[...new Set(vals)].map(x=>`<option value="${attr(x)}" ${x===cur?'selected':''}>${esc(x)}</option>`).join('')}`}
function updateStationEquipmentNames(){const type=$('stationEquipmentType')?.value||'';const sel=$('stationEquipmentName');if(sel)sel.innerHTML=stationEquipmentNameOptions(sel.value,type);updateStationEquipmentNumbers()}
function updateStationEquipmentNumbers(){const type=$('stationEquipmentType')?.value||'';const name=$('stationEquipmentName')?.value||'';const sel=$('stationEquipmentNumber');if(sel)sel.innerHTML=stationEquipmentNumberOptions(sel.value,type,name)}
function stationSelect(name,label,v,opts){return `<div class="field"><label>${esc(label)}</label><select name="${attr(name)}" required>${opts}</select></div>`}
function fieldInput(f,v){const raw=String(f).trim(),key=raw.toLowerCase(),safe=attr(v??'');if(key==='station name'||key==='station'){return `<div class="field"><label>${esc(f)}</label><select name="${attr(f)}" required>${stationOptions(v)}</select></div>`}if(key==='system'){return `<div class="field"><label>${esc(f)}</label><select name="${attr(f)}" required>${selectOptions('System',uniqueReportValues('System',['Automatic Gate']),v)}</select></div>`}if(key==='sub system'){return `<div class="field"><label>${esc(f)}</label><select name="${attr(f)}" required>${selectOptions('Sub System',uniqueReportValues('Sub System',['AG','BIDI AG','Exit Bidi AG','Exit AG']),v)}</select></div>`}if(key==='equipment type'){return `<div class="field"><label>${esc(f)}</label><select id="stationEquipmentType" name="${attr(f)}" required onchange="updateStationEquipmentNames()">${stationEquipmentTypeOptions(v)}</select></div>`}if(key==='equipment name'){return `<div class="field"><label>${esc(f)}</label><select id="stationEquipmentName" name="${attr(f)}" required onchange="updateStationEquipmentNumbers()">${stationEquipmentNameOptions(v,$('stationEquipmentType')?.value||'')}</select></div>`}if(key==='equipment number'){return `<div class="field"><label>${esc(f)}</label><select id="stationEquipmentNumber" name="${attr(f)}" required>${stationEquipmentNumberOptions(v,$('stationEquipmentType')?.value||'', $('stationEquipmentName')?.value||'')}</select></div>`}if(key==='equipment status / ag detail'){return `<div class="field"><label>${esc(f)}</label><input type="text" name="${attr(f)}" value="${safe}" placeholder="Enter AG detail"></div>`}if(key==='status'){return stationSelect(f,f,v,`<option value="">Select Status</option><option value="OK" ${String(v)==='OK'?'selected':''}>OK</option><option value="Not OK" ${String(v)==='Not OK'?'selected':''}>Not OK</option>`)}if(key==='agent'){const vals=[...new Set((state.users||[]).map(x=>x.name||x.id).filter(Boolean))];const cur=String(v??currentUser?.name??'');if(cur&&!vals.includes(cur))vals.unshift(cur);return `<div class="field"><label>${esc(f)}</label><select name="${attr(f)}" required><option value="">Select Agent</option>${vals.map(x=>`<option value="${attr(x)}" ${x===cur?'selected':''}>${esc(x)}</option>`).join('')}</select></div>`}if(key==='checklist item'){const vals=[...new Set([...(state.pmChecklistItems||[]),...(state.records.pm||[]).map(x=>x['Checklist Item']).filter(Boolean)])];const cur=String(v??'');if(cur&&!vals.includes(cur))vals.unshift(cur);return `<div class="field"><label>${esc(f)}</label><select name="${attr(f)}" required><option value="">Select Checklist Item</option>${vals.map(x=>`<option value="${attr(x)}" ${x===cur?'selected':''}>${esc(x)}</option>`).join('')}</select></div>`}if(key==='equipment serial number'){return `<div class="field"><label>${esc(f)}</label><input type="text" name="${attr(f)}" value="${safe}" required placeholder="Enter Equipment Serial Number"></div>`}if(key==='transaction file pending'){return stationSelect(f,f,v,`<option value="">Select Yes or No</option><option value="Yes" ${String(v)==='Yes'?'selected':''}>Yes</option><option value="No" ${String(v)==='No'?'selected':''}>No</option>`)}if(key==='equipment photo'){return `<div class="field full"><label>${esc(f)}</label><div class="photo-actions"><input id="stationEquipmentGallery" type="file" accept="image/*" hidden onchange="readStationEquipmentPhoto(event)"><input id="stationEquipmentCamera" type="file" accept="image/*" capture="environment" hidden onchange="readStationEquipmentPhoto(event)"><button type="button" class="btn gray" onclick="$('stationEquipmentGallery').click()">🖼️ Gallery / Browse</button><button type="button" class="btn primary" onclick="openCamera('stationEquipment')">📷 Camera</button></div><input id="stationEquipmentPhoto" name="${attr(f)}" type="hidden" value="${safe}"><div id="stationEquipmentPhotoPreview" class="photo-preview">${v?`<img src="${safe}" alt="Equipment">`:'No photo selected'}</div></div>`}if(key==='date'){return `<div class="field date-field"><label>${esc(f)}</label><div class="date-control"><input type="date" name="${attr(f)}" value="${safe}" aria-label="Select ${esc(f)}"><button type="button" class="calendar-btn" onclick="openNativePicker(this)">📅 Select Date</button></div></div>`}if(key==='date & time'||key==='datetime'||key==='date time'){return `<div class="field date-field"><label>${esc(f)}</label><div class="date-control"><input type="datetime-local" name="${attr(f)}" value="${safe}" aria-label="Select ${esc(f)}"><button type="button" class="calendar-btn" onclick="openNativePicker(this)">📅 Select Date & Time</button></div></div>`}if(key==='time'){return `<div class="field date-field"><label>${esc(f)}</label><div class="date-control"><input type="time" name="${attr(f)}" value="${safe}" aria-label="Select ${esc(f)}"><button type="button" class="calendar-btn" onclick="openNativePicker(this)">⏰ Select Time</button></div></div>`}return `<div class="field"><label>${esc(f)}</label><input type="text" name="${attr(f)}" value="${safe}" placeholder="Enter ${attr(f)}"></div>`}
function readEntryPhoto(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{$('entryPhoto').value=r.result;$('entryPhotoPreview').innerHTML=`<img src="${r.result}" alt="Entry">`;$('ocrStatus').textContent='Photo ready. Reading serial…';setTimeout(runSerialOCR,100)};r.readAsDataURL(f)}
function readStationEquipmentPhoto(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{const val=r.result;$('stationEquipmentPhoto').value=val;$('stationEquipmentPhotoPreview').innerHTML=`<img src="${val}" alt="Equipment">`};r.readAsDataURL(f)}
function renderRecordForm(obj){
 const r=reports[current];
 const wrap=(title,subtitle,fields,extra='')=>`<div class="report-specific-form ${attr('form-'+current)}"><div class="panel report-form-head"><h3>${esc(title)}</h3><div class="muted">${esc(subtitle)}</div></div><form class="form-grid report-form-grid" onsubmit="submitRecord(event)">${fields.map(f=>fieldInput(f,obj[f])).join('')}${extra}<div class="field full"><div class="actions"><button class="btn primary" type="submit">${editIndex===null?'Save Entry':'Update Entry'}</button><button type="button" class="btn gray" onclick="$('reportForm').innerHTML=''">Cancel</button></div></div></form></div>`;
 if(current==='station'){
   const inspection=['Date','S. No.','Station Name','System','Sub System'];
   const equipment=['Equipment Type','Equipment Name','Equipment Number','Equipment Serial Number'];
   const status=['Status','Transaction File Pending','Component / Part','Component Count'];
   const photo=['Equipment Photo'];
   $('reportForm').innerHTML=`<div class="report-specific-form form-station"><div class="panel report-form-head"><h3>Station AG Inspection</h3><div class="muted">Inspection details → equipment selection → component fault/count → status → photo.</div></div><form class="form-grid report-form-grid" onsubmit="submitRecord(event)"><div class="form-section full"><h4>Inspection Details</h4><div class="form-grid">${inspection.map(f=>fieldInput(f,obj[f])).join('')}</div></div><div class="form-section full"><h4>Equipment Details</h4><div class="form-grid">${equipment.map(f=>fieldInput(f,obj[f])).join('')}</div></div><div class="form-section full"><h4>Component / Status</h4><div class="form-grid">${status.map(f=>f==='Component / Part'?`<div class="field"><label>Component / Part (Auto Select)</label><select id="stationComponentSelect">${componentOptions(obj._selectedComponent||obj['Component / Part']||'')}</select></div>`:f==='Component Count'?`<div class="field"><label>Component Count</label><input id="stationComponentCount" type="number" min="0" step="1" value="${attr(obj._componentCount||obj['Component Count']||'1')}" placeholder="Enter count"></div>`:fieldInput(f,obj[f])).join('')}</div></div><div class="form-section full"><h4>Equipment Photo</h4>${photo.map(f=>fieldInput(f,obj[f])).join('')}</div><div class="field full"><div class="actions"><button class="btn primary" type="submit">${editIndex===null?'Save Inspection':'Update Inspection'}</button><button type="button" class="btn gray" onclick="$('reportForm').innerHTML=''">Cancel</button></div></div></form></div>`;
   updateStationEquipmentNames();return;
 }
 if(current==='pm'){$('reportForm').innerHTML=wrap('PM Checklist','Complete the checklist for the selected station and equipment/serial number.',['Date','Agent','Station','Serial Number','Checklist Item','Status','Remarks']);return;}
 if(current==='failure'){$('reportForm').innerHTML=`<div class="report-specific-form form-failure"><div class="panel report-form-head"><h3>Failure Entry</h3><div class="muted">Record the failure first, then classify L1 / PCR / D1 and close with status and remarks.</div></div><form class="form-grid report-form-grid" onsubmit="submitRecord(event)"><div class="form-section full"><h4>Failure Details</h4><div class="form-grid">${['Date','Time','Agent','Station','Serial Number','Failure Type'].map(f=>fieldInput(f,obj[f])).join('')}</div></div><div class="form-section full"><h4>Fault Classification</h4><div class="form-grid">${['L1','PCR','D1','Status','Remarks'].map(f=>fieldInput(f,obj[f])).join('')}</div></div><div class="field full"><div class="actions"><button class="btn primary" type="submit">${editIndex===null?'Save Failure':'Update Failure'}</button><button type="button" class="btn gray" onclick="$('reportForm').innerHTML=''">Cancel</button></div></div></form></div>`;return;}
 if(current==='material'){$('reportForm').innerHTML=`<div class="report-specific-form form-material"><div class="panel report-form-head"><h3>Material Entry</h3><div class="muted">Record material issue/receipt against the station and serial number.</div></div><form class="form-grid report-form-grid" onsubmit="submitRecord(event)"><div class="form-section full"><h4>Material Details</h4><div class="form-grid">${['Date','Agent','Station','Material','Quantity','Serial Number'].map(f=>fieldInput(f,obj[f])).join('')}</div></div><div class="form-section full"><h4>Remarks</h4><div class="form-grid">${fieldInput('Remarks',obj['Remarks'])}</div></div><div class="field full"><div class="actions"><button class="btn primary" type="submit">${editIndex===null?'Save Material':'Update Material'}</button><button type="button" class="btn gray" onclick="$('reportForm').innerHTML=''">Cancel</button></div></div></form></div>`;return;}
 if(current==='inventory'){$('reportForm').innerHTML=`<div class="report-specific-form form-inventory"><div class="panel report-form-head"><h3>Inventory Entry</h3><div class="muted">Update opening, received, issued and closing stock for the selected material.</div></div><form class="form-grid report-form-grid" onsubmit="submitRecord(event)"><div class="form-section full"><h4>Inventory Details</h4><div class="form-grid">${['Date','Agent','Station','Material','Serial Number'].map(f=>fieldInput(f,obj[f])).join('')}</div></div><div class="form-section full"><h4>Stock Movement</h4><div class="form-grid">${['Opening','Received','Issued','Closing'].map(f=>fieldInput(f,obj[f])).join('')}</div></div><div class="field full"><div class="actions"><button class="btn primary" type="submit">${editIndex===null?'Save Inventory':'Update Inventory'}</button><button type="button" class="btn gray" onclick="$('reportForm').innerHTML=''">Cancel</button></div></div></form></div>`;return;}
 if(current==='addinventory'){$('reportForm').innerHTML=`<div class="report-specific-form form-addinventory"><div class="panel report-form-head"><h3>Add New Inventory</h3><div class="muted">Add stock into the master inventory with unit, opening stock and added quantity.</div></div><form class="form-grid report-form-grid" onsubmit="submitRecord(event)"><div class="form-section full"><h4>New Inventory</h4><div class="form-grid">${['Date','Material','Unit','Opening Stock','Added Quantity','Serial Number'].map(f=>fieldInput(f,obj[f])).join('')}</div></div><div class="form-section full"><h4>Remarks</h4><div class="form-grid">${fieldInput('Remarks',obj['Remarks'])}</div></div><div class="field full"><div class="actions"><button class="btn primary" type="submit">${editIndex===null?'Add Inventory':'Update Inventory'}</button><button type="button" class="btn gray" onclick="$('reportForm').innerHTML=''">Cancel</button></div></div></form></div>`;return;}
 $('reportForm').innerHTML=wrap(r.title,'Use the fields defined for this report.',r.fields);
}

function submitRecord(e){e.preventDefault();const p=permsFor(currentUser,current);if(editIndex===null&&!p.add)return;if(editIndex!==null&&!p.edit)return;const d=Object.fromEntries(new FormData(e.target).entries());if(current==='station'){const c=$('stationComponentSelect')?.value||d['Component / Part']||'';const n=Number($('stationComponentCount')?.value||d['Component Count']||0);d['Component / Part']=c;d['Component Count']=n?String(n):'';if(c&&n>0){d[c]=String(n);d._selectedComponent=c;d._componentCount=n}}if(!d.Date)d.Date=new Date().toISOString().slice(0,10);if(current==='station'){const photo=$('stationEquipmentPhoto')?.value||'';d['Equipment Photo']=photo;d._photo=photo}else{d._photo=$('entryPhoto')?.value||'';d['Part / Product Photo']=d._photo;d['Entry Photo']=d._photo}d['Agent']=d['Agent']||currentUser.name;d['Employee ID / User Name']=d['Employee ID / User Name']||currentUser.id;d._userId=currentUser.id;d._userName=currentUser.name;d._savedAt=new Date().toISOString();d._recordId=d._recordId||`${current}-${Date.now()}-${Math.random().toString(36).slice(2,10)}`;if(current==='summary'){} if(editIndex===null)state.records[current].push(d);else state.records[current][editIndex]=d;state.activities.push(`${reports[current].title} ${editIndex===null?'added':'updated'} by ${currentUser.name}`);save();$('reportForm').innerHTML='';renderReport();renderDashboard()}
function editRecord(i){if(current==='summary'){alert('Final Summary is generated automatically from report entries.');return}if(!permsFor(currentUser,current).edit){alert('Edit permission is not granted.');return}editIndex=i;renderRecordForm(state.records[current][i])}
function deleteRecord(i){if(!isAdmin()){alert('Only Admin can delete report records.');return}if(current==='summary'){alert('Final Summary is generated automatically from report entries. Delete the original report entry instead.');return}const row=(state.records[current]||[])[i];if(!row)return;if(!confirm('Delete this record? It will be moved to Deleted Records and kept until Admin permanently deletes it.'))return;state.deletedRecords ||= [];state.deletedRecords.push({reportKey:current,reportName:reports[current].title,record:deepClone(row),deletedBy:currentUser.name||currentUser.id,deletedAt:new Date().toISOString()});state.records[current].splice(i,1);state.activities.push(`${reports[current].title} record moved to Deleted Records by ${currentUser.name}`);save();renderReport();renderDashboard()}
async function reverseLocationName(lat,lng){try{const r=await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lng)}&zoom=18&addressdetails=1`,{headers:{'Accept':'application/json'}});if(!r.ok)return 'Live GPS Location';const j=await r.json();return j.display_name||'Live GPS Location'}catch(e){return 'Live GPS Location'}}
function recordSessionLocation(pos,event,done){if(!currentUser||!pos?.coords){if(done)done(null);return null}const now=Date.now(),lat=Number(pos.coords.latitude),lng=Number(pos.coords.longitude),iso=new Date(now).toISOString(),gpsUrl=`https://www.google.com/maps?q=${lat},${lng}`;const loc={_locationId:`${currentUser.id}-${event}-${now}-${Math.random().toString(36).slice(2,7)}`,sessionId:currentSessionId,event,employeeCode:currentUser.employeeCode||currentUser.code||currentUser.id||'',employeeId:currentUser.id||'',userId:currentUser.id||'',name:currentUser.name||'',employeeName:currentUser.name||'',loginDateTime:event==='login'?iso:(currentUser.loginDateTime||''),logoutDateTime:event==='logout'?iso:'',datetime:iso,lat,lng,gpsUrl,map:gpsUrl,locationName:'GPS Location'};state.locations ||= [];state.locations.push(loc);save();renderLocation();reverseLocationName(lat,lng).then(name=>{const x=state.locations.find(v=>v._locationId===loc._locationId);if(x){x.locationName=name;save();renderLocation();}if(done)done(loc)}).catch(()=>{if(done)done(loc)});return loc}
function captureSessionLocation(event,done){if(!currentUser||!navigator.geolocation){if(done)done(null);return}navigator.geolocation.getCurrentPosition(pos=>recordSessionLocation(pos,event,done),()=>{if(done)done(null)},{enableHighAccuracy:true,timeout:10000,maximumAge:0})}
function captureLocation(data){if(!navigator.geolocation)return;navigator.geolocation.getCurrentPosition(pos=>{const loc=recordSessionLocation(pos,'entry');if(data&&loc){data._lat=loc.lat;data._lng=loc.lng;data._map=loc.map;data._locationName=loc.locationName;data._locationTime=loc.datetime;}},()=>{},{enableHighAccuracy:true,timeout:10000,maximumAge:0})}
function startLiveLocationTracking(){}
function stopLiveLocationTracking(){}
let locationPage=1;
function locationRowsForPage(){const rows=[...(state.locations||[])].sort((a,b)=>String(b.datetime||'').localeCompare(String(a.datetime||'')));const total=Math.max(1,Math.ceil(rows.length/30));if(locationPage>total)locationPage=total;const from=(locationPage-1)*30;return {rows,total,pageRows:rows.slice(from,from+30)}}
function renderLocation(){
 const pager=locationRowsForPage();
 if($('locationActions'))$('locationActions').innerHTML=isAdmin()?`<button class="btn gray" onclick="exportLocationExcel()">Export Excel</button><button class="btn gray" onclick="printLocation()">Export PDF</button><button class="btn primary" onclick="document.getElementById('locationImportFile').click()">Import Excel/CSV</button><input id="locationImportFile" type="file" accept=".csv,.xlsx,.xls" hidden onchange="importLocationHistory(event)">`:'';
 const b=$('locationBody');b.innerHTML=pager.pageRows.map((x,localIndex)=>{const url=x.gpsUrl||x.map||'';const realIndex=(pager.page-1)*30+localIndex;return `<tr><td>${esc(x.employeeCode||x.employeeId||x.userId||'')}</td><td>${esc(x.employeeId||x.userId||'')}</td><td>${esc(x.name||x.employeeName||'')}</td><td>${esc(x.loginDateTime?new Date(x.loginDateTime).toLocaleString():'—')}</td><td>${esc(x.logoutDateTime?new Date(x.logoutDateTime).toLocaleString():'Active')}</td><td>${esc(x.datetime?new Date(x.datetime).toLocaleString():'')}</td><td>${Number(x.lat).toFixed(6)}</td><td>${Number(x.lng).toFixed(6)}</td><td>${url?`<a href="${attr(url)}" target="_blank" rel="noopener">GPS URL</a>`:'—'}</td><td>${url?`<a class="btn gray" href="${attr(url)}" target="_blank" rel="noopener">Open Map</a>`:'—'}</td><td>${esc(x.locationName||'Live GPS Location')}</td>${isAdmin()?`<td><button class="btn danger small-btn" onclick="deleteLocationRow(${realIndex})">Delete</button></td>`:''}</tr>`}).join('')||`<tr><td colspan="${isAdmin()?12:11}" class="empty">No live GPS entries yet. Allow location access on the employee device.</td></tr>`;
 let pagerEl=$('locationPager');if(!pagerEl){const page=$('location');page?.insertAdjacentHTML('beforeend',`<div id="locationPager"></div><div id="locationDeletePanel"></div>`);pagerEl=$('locationPager');}
 pagerEl.innerHTML=`<div class="location-pager"><button class="btn gray" ${pager.page<=1?'disabled':''} onclick="changeLocationPage(-1)">‹ Previous</button><span>Page ${pager.page} of ${pager.total} • ${pager.rows.length} records</span><button class="btn gray" ${pager.page>=pager.total?'disabled':''} onclick="changeLocationPage(1)">Next ›</button></div>`;
 if(isAdmin()){const panel=$('locationDeletePanel');panel.innerHTML=`<div class="panel location-delete-panel"><h3>Admin: Delete Location History</h3><div class="form-grid"><div class="field"><label>From Date</label><input id="locDeleteFrom" type="date"></div><div class="field"><label>To Date *</label><input id="locDeleteTo" type="date"></div><div class="field full"><div class="muted">Deleted records are removed from the portal but kept in the backup archive.</div><button class="btn danger" type="button" onclick="deleteLocationByDate()">Delete Selected History From Portal</button></div></div></div>`;}}
function changeLocationPage(delta){locationPage=Math.max(1,locationPage+delta);renderLocation()}
function deleteLocationRow(i){if(!isAdmin())return;const rows=[...(state.locations||[])].sort((a,b)=>String(b.datetime||'').localeCompare(String(a.datetime||'')));const row=rows[i];if(!row)return;if(!confirm('Delete this location history record from the portal? It will remain in the backup archive.'))return;archiveAndRemoveLocations([row]);}
function deleteLocationByDate(){if(!isAdmin())return;const from=$('locDeleteFrom')?.value||'',to=$('locDeleteTo')?.value||'';if(!to)return alert('Please select To Date.');if(from&&from>to)return alert('From Date cannot be after To Date.');const matches=(state.locations||[]).filter(x=>{const d=String(x.datetime||'').slice(0,10);return d&&d>=from&&d<=to});if(!matches.length)return alert('No location history found for the selected date range.');if(!confirm(`Delete ${matches.length} location history record(s) from the portal? Backup archive will be retained.`))return;archiveAndRemoveLocations(matches);}
function archiveAndRemoveLocations(matches){state.deletedLocationHistory ||= [];const ids=new Set(matches.map(x=>x._locationId||`${x.employeeId}|${x.datetime}|${x.lat}|${x.lng}`));state.deletedLocationHistory.push(...matches.map(x=>({...deepClone(x),deletedFromPortalAt:new Date().toISOString(),deletedFromPortalBy:currentUser.name||currentUser.id})));state.locations=(state.locations||[]).filter(x=>!ids.has(x._locationId||`${x.employeeId}|${x.datetime}|${x.lat}|${x.lng}`));locationPage=1;state.activities.push(`Location history deleted from portal by ${currentUser.name}`);save();renderLocation();}
function importLocationHistory(e){if(!isAdmin())return;const f=e.target.files[0];if(!f)return;parseFile(f,rows=>{const mapped=rows.map(raw=>{const out={};['Employee Code','Employee ID','Name','Login Date & Time','Logout Date & Time','Date & Time','Latitude','Longitude','GPS URL','Map','Location Name'].forEach(f=>{const hit=Object.keys(raw).find(h=>h.trim().toLowerCase()===f.toLowerCase());out[f]=hit?raw[hit]:''});return {_locationId:`import-${Date.now()}-${Math.random().toString(36).slice(2,7)}`,employeeCode:out['Employee Code'],employeeId:out['Employee ID'],userId:out['Employee ID'],name:out.Name,employeeName:out.Name,loginDateTime:out['Login Date & Time'],logoutDateTime:out['Logout Date & Time'],datetime:out['Date & Time']||out['Login Date & Time'],lat:Number(out.Latitude)||0,lng:Number(out.Longitude)||0,gpsUrl:out['GPS URL']||out.Map,map:out.Map||out['GPS URL'],locationName:out['Location Name']||'Imported Location',_importedAt:new Date().toISOString()};}).filter(x=>x.datetime||x.lat||x.lng);state.locations ||= [];state.locations.push(...mapped);save();renderLocation();alert(`Imported ${mapped.length} location history records. Existing records were preserved.`)});e.target.value=''}
function exportLocationExcel(){downloadWorkbook([{name:'Agent Location History',rows:state.locations.map(x=>({'Employee Code':x.employeeCode||x.employeeId||x.userId||'','Employee ID':x.employeeId||x.userId||'','Name':x.name||x.employeeName||'','Login Date & Time':x.loginDateTime?new Date(x.loginDateTime).toLocaleString():'','Logout Date & Time':x.logoutDateTime?new Date(x.logoutDateTime).toLocaleString():'','Date & Time':new Date(x.datetime).toLocaleString(),Latitude:x.lat,Longitude:x.lng,'GPS URL':x.gpsUrl||x.map||'','Map':x.map||x.gpsUrl||'','Location Name':x.locationName||'Live GPS Location'}))}], 'Agent_Location_History.xlsx')}
function printLocation(){const headers=['Employee Code','Employee ID','Name','Login Date & Time','Logout Date & Time','Date & Time','Latitude','Longitude','GPS URL','Map','Location Name'];const rows=state.locations.map(x=>headers.map(h=>({'Employee Code':x.employeeCode||x.employeeId||x.userId||'','Employee ID':x.employeeId||x.userId||'','Name':x.name||x.employeeName||'','Login Date & Time':x.loginDateTime?new Date(x.loginDateTime).toLocaleString():'','Logout Date & Time':x.logoutDateTime?new Date(x.logoutDateTime).toLocaleString():'','Date & Time':new Date(x.datetime).toLocaleString(),Latitude:x.lat,Longitude:x.lng,'GPS URL':x.gpsUrl||x.map||'','Map':x.map||x.gpsUrl||'','Location Name':x.locationName||'Live GPS Location'}[h])));printTable('Agent Location History',headers,rows)}
function currentSummaryFilteredRows(){let rows=summaryRows();const from=$('sumFrom')?.value||'',to=$('sumTo')?.value||'',agent=$('sumAgent')?.value||'',rep=$('sumReport')?.value||'';return rows.filter(x=>{const d=String(x['Date & Time']||x.Date||'').slice(0,10);return(!from||d>=from)&&(!to||d<=to)&&(!agent||x.Agent===agent)&&(!rep||x._source===rep)})}
function currentCCRFilteredRows(){let rows=ccrViewRows(ccrVisibleRows());const from=$('ccrFrom')?.value||'',to=$('ccrTo')?.value||'',status=$('ccrStatusFilter')?.value||'',q=($('ccrSearchFilter')?.value||'').toLowerCase();return rows.filter(x=>{const d=String(x['Complaint Received Date/Time']||x.Date||'').slice(0,10);const hay=Object.values(x).filter(v=>v!==undefined&&v!==null).join(' ').toLowerCase();return(!from||d>=from)&&(!to||d<=to)&&(!status||String(x['Reply Status']||x['Resolution Status']||'').toLowerCase()===status)&&(!q||hay.includes(q))})}
function exportExcel(k){const rows=k==='summary'?currentSummaryFilteredRows():(k===CCR_REPORT_KEY?currentCCRFilteredRows():getGenericFilteredRows(state.records[k]||[]).map(x=>{const y={...x};delete y.__index;return y;}));downloadWorkbook([{name:reports[k].title.slice(0,31),rows}],`${reports[k].title.replace(/[^a-z0-9]+/gi,'_')}.xlsx`)}
function exportPDF(k){const r=reports[k];const rows=k==='summary'?currentSummaryFilteredRows():(k===CCR_REPORT_KEY?currentCCRFilteredRows():getGenericFilteredRows(state.records[k]||[]));printTable(r.title,r.fields,rows.map(x=>r.fields.map(f=>x[f]??'')))}
function printTable(title,heads,rows){const w=window.open('','_blank');if(!w){alert('Please allow popups for PDF print.');return}w.document.write(`<html><head><title>${esc(title)}</title><style>body{font-family:Arial;padding:20px}h2{margin-bottom:15px}table{border-collapse:collapse;width:100%;font-size:11px}th,td{border:1px solid #bbb;padding:6px;text-align:left}th{background:#eee}@media print{button{display:none}}</style></head><body><h2>${esc(title)}</h2><table><thead><tr>${heads.map(h=>`<th>${esc(h)}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${esc(c)}</td>`).join('')}</tr>`).join('')}</tbody></table><script>window.onload=()=>window.print()<\/script></body></html>`);w.document.close()}
function downloadWorkbook(sheets,filename){if(window.XLSX){const wb=XLSX.utils.book_new();sheets.forEach(s=>XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(s.rows),s.name));XLSX.writeFile(wb,filename);return}let html='<table><tr>'+Object.keys(sheets[0].rows[0]||{}).map(x=>`<th>${esc(x)}</th>`).join('')+'</tr>';(sheets[0].rows||[]).forEach(r=>html+=`<tr>${Object.values(r).map(v=>`<td>${esc(v)}</td>`).join('')}</tr>`);html+='</table>';download(filename.replace('.xlsx','.xls'),html,'application/vnd.ms-excel')}
function download(name,data,type){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([data],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function normalizeRows(rows,k){const fields=reports[k].fields;return rows.map(raw=>{const out={};fields.forEach(f=>{const hit=Object.keys(raw).find(h=>h.trim().toLowerCase()===f.toLowerCase());out[f]=hit?raw[hit]:''});return out})}
function parseFile(file,cb){if(!file)return;const ext=file.name.toLowerCase().split('.').pop();const r=new FileReader();r.onload=e=>{try{if((ext==='xlsx'||ext==='xls')&&window.XLSX){const wb=XLSX.read(e.target.result,{type:'array'});const all=[];wb.SheetNames.forEach(sn=>{const ws=wb.Sheets[sn];XLSX.utils.sheet_to_json(ws,{defval:''}).forEach(x=>{if(!Object.keys(x).some(k=>/^(role|report|report name|role\/report)$/i.test(k)))x.Role=sn;all.push(x)})});cb(all);}else{cb(csvToRows(new TextDecoder().decode(e.target.result)))} }catch(err){alert('Could not read file: '+err.message)}};r.readAsArrayBuffer(file)}
function csvToRows(txt){const lines=txt.split(/\r?\n/).filter(x=>x.trim());if(!lines.length)return[];const parse=s=>{let a=[],c='',q=false;for(let i=0;i<s.length;i++){const ch=s[i];if(ch==='"'&&s[i+1]==='"'){c+='"';i++;continue}if(ch==='"'){q=!q;continue}if(ch===','&&!q){a.push(c);c='';continue}c+=ch}a.push(c);return a};const h=parse(lines[0]);return lines.slice(1).map(l=>{const v=parse(l),o={};h.forEach((x,i)=>o[x.trim()]=v[i]||'');return o})}
function populateImportTargets(){const sel=$('importTarget');if(sel)sel.innerHTML='<option value="">Auto detect all reports from workbook</option>'+Object.keys(reports).filter(k=>k!=='summary').map(k=>`<option value="${k}">${esc(reports[k].title)}</option>`).join('')}
let lastImportWarnings=[];function importRowsAuto(rows,forced){const imported=[];lastImportWarnings=[];rows.forEach(raw=>{const keys=Object.keys(raw);let target=forced;const roleKey=keys.find(k=>/^(role|report|report name|role\/report)$/i.test(k));if(!target&&roleKey){const rv=String(raw[roleKey]||'').trim().toLowerCase();target=Object.keys(reports).find(k=>k.toLowerCase()===rv||roleLabel(k).toLowerCase()===rv)}if(!target){let best={k:null,score:0};Object.keys(reports).filter(k=>k!=='summary').forEach(k=>{const fs=reports[k].fields.map(x=>x.toLowerCase());const score=keys.reduce((n,h)=>n+(fs.includes(h.trim().toLowerCase())?1:0),0);if(score>best.score)best={k,score}});target=best.k}if(target&&reports[target]){const out=normalizeRows([raw],target)[0];if(target==='station'){['Remark','Action Remarks','GV 7 Display Faulty Count',...COMPONENT_MASTER].forEach(f=>{const hit=keys.find(h=>h.trim().toLowerCase()===f.toLowerCase());if(hit)out[f]=raw[hit]});const found=COMPONENT_MASTER.filter(f=>{const hit=keys.find(h=>h.trim().toLowerCase()===f.toLowerCase());return hit&&String(raw[hit]??'').trim()!==''&&Number(raw[hit])!==0});if(found.length===1){out['Component / Part']=found[0];out['Component Count']=String(raw[keys.find(h=>h.trim().toLowerCase()===found[0].toLowerCase())]??'');out._selectedComponent=found[0];out._componentCount=Number(raw[keys.find(h=>h.trim().toLowerCase()===found[0].toLowerCase())])||0}else if(found.length>1){out['Component / Part']=found[0];out['Component Count']=String(raw[keys.find(h=>h.trim().toLowerCase()===found[0].toLowerCase())]??'');out._selectedComponent=found[0];out._componentCount=Number(raw[keys.find(h=>h.trim().toLowerCase()===found[0].toLowerCase())])||0;lastImportWarnings.push(`Row has multiple component columns; preserved all component values and selected ${found[0]} for Auto Select.`)}}out._importedAt=new Date().toISOString();imported.push([target,out])}});return imported}
function runImport(){if(!isAdmin())return alert('Only Admin can import Master data.');const f=$('importFileMain').files[0];if(!f)return alert('Select a file.');const forced=$('importTarget').value||null;parseFile(f,rows=>{const pairs=importRowsAuto(rows,forced);pairs.forEach(([k,row])=>{state.records[k] ||= [];state.records[k].push(row)});state.activities.push(`Imported ${pairs.length} rows with automatic report/role mapping`);save();$('importStatus').textContent=`Imported ${pairs.length} rows. Existing records were preserved. Columns were mapped by headers.${lastImportWarnings.length?' '+lastImportWarnings.length+' warning(s): '+lastImportWarnings.slice(0,3).join(' '):''}`;if(lastImportWarnings.length)alert(`Import completed with ${lastImportWarnings.length} warning(s). Existing data was preserved.\n\n${lastImportWarnings.slice(0,5).join('\n')}`);renderDashboard()})}
function importIntoCurrent(e){const f=e.target.files[0];if(!f)return;parseFile(f,rows=>{if(current==='summary'){const target='station';const n=normalizeRows(rows,target);state.records[target].push(...n.map(x=>({...x,Date:x.Date||new Date().toISOString().slice(0,10),Agent:x.Agent||currentUser?.name||'',_userId:currentUser?.id||'',_userName:currentUser?.name||'',_savedAt:new Date().toISOString()})));save();renderReport();alert(`Imported ${n.length} Inventory rows into Station AG Inspection and refreshed Final Summary.`);return}const n=normalizeRows(rows,current);state.records[current].push(...n);save();renderReport();alert(`Imported ${n.length} rows.`)})}
function downloadImportTemplate(){const sheets=Object.keys(reports).filter(k=>k!=='summary').map(k=>({name:reports[k].title.slice(0,31),rows:[{Role:reports[k].title,...Object.fromEntries(reports[k].fields.map(f=>[f,'']))}]}));downloadWorkbook(sheets,'NMRC Inventory_All_Roles_Import_Template.xlsx')}
function exportAllData(){const sheets=driveBackupSheets();sheets.push({name:'Users',rows:state.users.map(u=>({...u,password:undefined}))});downloadWorkbook(sheets,'NMRC_INVENTORY_BACKUP.xlsx')}
function createDynamicReport(){const name=prompt('New report name?');if(!name?.trim())return;const raw=prompt('Fields separated by comma?','Date,Agent,Station,Serial Number,Remarks');if(!raw)return;const fields=raw.split(',').map(x=>x.trim()).filter(Boolean);if(!fields.length)return;const k='dynamic_'+Date.now();reports[k]={title:name.trim(),fields};state.records[k]=[];state.dynamic.push(k);state.reportDefs[k]=reports[k];save();renderNav();renderBuilder();openReport(k)}
function renderBuilder(){const d=$('builderList');d.innerHTML=(state.dynamic||[]).map(k=>`<div class="panel" style="margin-top:14px"><h3>${esc(reports[k].title)}</h3><p>${reports[k].fields.map(esc).join(' • ')}</p><div class="actions"><button class="btn primary" onclick="openReport('${k}')">Open Report</button><button class="btn danger" onclick="deleteDynamic('${k}')">Delete Report</button></div></div>`).join('')||'<div class="panel" style="margin-top:14px"><div class="empty">No custom reports created yet.</div></div>'}
function deleteDynamic(k){if(!isAdmin()||!confirm('Delete this custom report and its records?'))return;delete reports[k];delete state.records[k];state.dynamic=state.dynamic.filter(x=>x!==k);delete state.reportDefs[k];save();renderNav();renderBuilder()}
function normalizeUser(u){u.roles ||= [];u.permissions ||= {};applyCCRRolePermissions(u);return u}
function renderUsers(){if(!isAdmin())return;const body=$('userBody');$('userCount').textContent=`Total Users: ${state.users.length}`;body.innerHTML=state.users.map((u,i)=>{const roles=u.roles?.length?u.roles:[];const roleText=[roles.length===STATIC_ROLES.length?'All Roles':roles.map(roleLabel).join(', ')||'None',u.ccrRole?`CCR: ${u.ccrRole}`:''].filter(Boolean).join(' • ');const p=roles.map(k=>`${roleLabel(k)} A:${u.permissions?.[k]?.add?'✓':'×'} E:${u.permissions?.[k]?.edit?'✓':'×'} D:${u.permissions?.[k]?.delete?'✓':'×'}`).join('<br>');return `<tr><td>${u.photo?`<img class="user-thumb" src="${attr(u.photo)}">`:'—'}</td><td>${esc(u.name)}</td><td>${esc(u.id)}</td><td>${esc(u.mobile)}</td><td>${esc(roleText)}</td><td>${u.lastLogin?esc(new Date(u.lastLogin).toLocaleString()):'Never'}</td><td class="permission-cell">${p||'No report access'}</td><td><button class="btn primary small-btn" onclick="editUser(${i})">Edit</button> <button class="btn danger small-btn" onclick="deleteUser(${i})">Delete</button></td></tr>`}).join('')||'<tr><td colspan="8" class="empty">No users created yet.</td></tr>'}
function renderUserForm(index){if(!isAdmin())return;userEditIndex=index;const u=index===null?{name:'',id:'',password:'',mobile:'',photo:'',roles:[],permissions:{},ccrRoles:[],ccrPermissions:{}}:state.users[index];const roleKeys=[...STATIC_ROLES.map(x=>x[0]),...state.dynamic];const all=roleKeys.length>0&&roleKeys.every(k=>u.roles?.includes(k));$('userCreationForm').innerHTML=`<div class="panel user-create"><div class="form-head"><div><h3>${index===null?'User Creation':'Edit User'}</h3><div class="muted">Admin assigns one role, multiple roles, or Select All Roles. Permissions are per report.</div></div><span class="admin-badge">ADMIN ONLY</span></div><form class="form-grid" onsubmit="saveUser(event)"><div class="field"><label>Employee Name *</label><input name="name" required value="${attr(u.name)}"></div><div class="field"><label>Employee ID *</label><input name="id" required value="${attr(u.id)}" ${index!==null?'readonly':''}></div><div class="field"><label>Employee Password *</label><input name="password" type="password" required value="${attr(u.password||'')}"></div><div class="field"><label>Employee Mobile Number *</label><input name="mobile" required value="${attr(u.mobile)}"></div><div class="field"><label>Employee Photo (Admin only)</label><div class="photo-actions"><input id="employeeGallery" type="file" accept="image/*" hidden onchange="previewEmployeePhoto(event)"><input id="employeeCamera" type="file" accept="image/*" capture="user" hidden onchange="previewEmployeePhoto(event)"><button type="button" class="btn gray" onclick="$('employeeGallery').click()">🖼️ Gallery</button><button type="button" class="btn primary" onclick="openCamera('employee')">📷 Camera</button></div><input id="employeePhotoData" type="hidden" value="${attr(u.photo||'')}"><div id="employeePhotoPreview" class="photo-preview">${u.photo?`<img src="${attr(u.photo)}">`:'No photo selected'}</div></div><div class="field full"><label>CCR User Role — Select which CCR role this user should have</label><div class="ccr-role-checks">${CCR_ROLE_OPTIONS.map(r=>`<label class="check-row ccr-role-check"><input class="ccr-role-choice" type="checkbox" value="${attr(r)}" ${getCCRRoles(u).includes(r)?'checked':''}> <b>${esc(r)}</b></label>`).join('')}</div><div class="muted">Select one or more CCR roles for this user. Then set the exact report permissions below.</div><div class="role-permission-list"><div class="role-permission-row five"><b>CCR Report</b><b>View</b><b>Add</b><b>Edit</b><b>Delete</b></div>${Object.entries({management:'CCR Management',received:'Complaint Received',status:'Complaint Reply / Pending Status',final:'Final Summary'}).map(([k,n])=>{const pr=u.ccrPermissions?.[k]||{};return `<div class="role-permission-row five"><b>${n}</b><label><input class="ccr-perm-view" data-ccr-report="${k}" type="checkbox" ${pr.view?'checked':''}> View</label><label><input class="ccr-perm-add" data-ccr-report="${k}" type="checkbox" ${pr.add?'checked':''}> Add</label><label><input class="ccr-perm-edit" data-ccr-report="${k}" type="checkbox" ${pr.edit?'checked':''}> Edit</label><label><input class="ccr-perm-delete" data-ccr-report="${k}" type="checkbox" ${pr.delete?'checked':''}> Delete</label></div>`}).join('')}</div></div><div class="field full"><label>Role Selection</label><select id="roleSelector" onchange="roleSelectorChanged(this)"><option value="__all__">Select All Roles</option><option value="__none__">Clear Role Selection</option>${roleKeys.map(k=>`<option value="${attr(k)}">${esc(roleLabel(k))}</option>`).join('')}</select><label class="check-row role-all"><input id="allRoles" type="checkbox" ${all?'checked':''} onchange="toggleAllRoles(this)"><b>Select All Roles</b><span class="muted">Select every report / role at once</span></label><div class="role-permission-list"><div class="role-permission-row"><b>Report / Role</b><b>View</b><b>Add</b><b>Edit</b><b>Delete</b></div>${roleKeys.map(k=>{const pr=u.permissions?.[k]||{};return `<div class="role-permission-row five"><label class="role-check"><input class="role-access" data-role="${attr(k)}" type="checkbox" ${u.roles?.includes(k)?'checked':''}> <b>${esc(roleLabel(k))}</b></label><label><input class="perm-view" data-role="${attr(k)}" type="checkbox" ${u.roles?.includes(k)?'checked':''}> View</label><label><input class="perm-add" data-role="${attr(k)}" type="checkbox" ${pr.add?'checked':''}> Add</label><label><input class="perm-edit" data-role="${attr(k)}" type="checkbox" ${pr.edit?'checked':''}> Edit</label><label><input class="perm-delete" data-role="${attr(k)}" type="checkbox" ${pr.delete?'checked':''}> Delete</label></div>`}).join('')}</div></div><div class="field full"><div class="actions"><button class="btn primary">${index===null?'＋ Create User':'✓ Update User'}</button><button type="button" class="btn gray" onclick="cancelUserForm()">Cancel</button></div></div></form></div>`;$('userCreationForm').scrollIntoView({behavior:'smooth',block:'start'})}
function roleSelectorChanged(sel){if(sel.value==='__all__'){const cb=$('allRoles');if(cb){cb.checked=true;toggleAllRoles(cb)}}else if(sel.value==='__none__'){document.querySelectorAll('.role-access,.perm-view').forEach(x=>x.checked=false);if($('allRoles'))$('allRoles').checked=false}else{const k=sel.value;const ra=document.querySelector(`.role-access[data-role="${CSS.escape(k)}"]`);const pv=document.querySelector(`.perm-view[data-role="${CSS.escape(k)}"]`);if(ra)ra.checked=true;if(pv)pv.checked=true;if($('allRoles'))$('allRoles').checked=false}}
function toggleAllRoles(cb){document.querySelectorAll('.role-access,.perm-view').forEach(x=>x.checked=cb.checked)}
function previewEmployeePhoto(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{$('employeePhotoData').value=r.result;$('employeePhotoPreview').innerHTML=`<img src="${r.result}">`};r.readAsDataURL(f)}
function saveUser(e){e.preventDefault();const d=Object.fromEntries(new FormData(e.target).entries());const roleKeys=[...STATIC_ROLES.map(x=>x[0]),...state.dynamic];const roles=[...document.querySelectorAll('.role-access:checked')].map(x=>x.dataset.role);if(!roles.length)return alert('Select at least one role or Select All Roles.');const permissions={};roleKeys.forEach(k=>permissions[k]={view:$(`.perm-view[data-role="${CSS.escape(k)}"]`)?.checked||false,add:$(`.perm-add[data-role="${CSS.escape(k)}"]`)?.checked||false,edit:$(`.perm-edit[data-role="${CSS.escape(k)}"]`)?.checked||false,delete:$(`.perm-delete[data-role="${CSS.escape(k)}"]`)?.checked||false});const ccrRoles=[...document.querySelectorAll('.ccr-role-choice:checked')].map(x=>x.value).filter(Boolean);const ccrPermissions={};Object.keys(CCR_REPORT_KEYS).forEach(k=>ccrPermissions[k]={view:$(`.ccr-perm-view[data-ccr-report="${k}"]`)?.checked||false,add:$(`.ccr-perm-add[data-ccr-report="${k}"]`)?.checked||false,edit:$(`.ccr-perm-edit[data-ccr-report="${k}"]`)?.checked||false,delete:$(`.ccr-perm-delete[data-ccr-report="${k}"]`)?.checked||false});const u={name:d.name.trim(),id:d.id.trim(),password:d.password,mobile:d.mobile.trim(),photo:$('employeePhotoData').value,roles,allRoles:$('allRoles')?.checked||false,permissions,ccrRoles,ccrRole:ccrRoles[0]||'',ccrPermissions,lastLogin:userEditIndex===null?'':(state.users[userEditIndex]?.lastLogin||''),_updatedAt:new Date().toISOString()};if(userEditIndex===null){if(state.users.some(x=>x.id.toLowerCase()===u.id.toLowerCase()))return alert('Employee ID already exists.');state.users.push(u);state.activities.push(`New employee ${u.name} created`)}else{state.users[userEditIndex]=u;state.activities.push(`Employee ${u.name} updated`)}save();userEditIndex=null;if($('userForm'))$('userCreationForm').innerHTML='';renderNav();showUsers(false);renderDashboard()}
function cancelUserForm(){userEditIndex=null;$('userCreationForm').innerHTML=''}
function editUser(i){if(!isAdmin())return;showPage('userCreation');if($('userCreationForm'))$('userCreationForm').innerHTML='';renderUserForm(i)}
function deleteUser(i){if(!confirm('Delete this employee?'))return;state.users.splice(i,1);save();renderUsers();renderNav()}
function downloadBackup(){download('aurionpro_backup.json',JSON.stringify(state,null,2),'application/json')}
function restoreBackup(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{state=JSON.parse(r.result);Object.keys(BASE_REPORTS).forEach(k=>state.records[k] ||= []);state.reportDefs ||= {};reports=deepClone(BASE_REPORTS);(state.dynamic||[]).forEach(k=>{if(state.reportDefs[k])reports[k]=state.reportDefs[k]});save();renderNav();renderDashboard();alert('Backup restored.')}catch(err){alert('Invalid backup file.')}};r.readAsText(f)}
document.addEventListener('DOMContentLoaded',()=>{
 if($('loginPage'))$('loginPage').classList.remove('hidden');
 if($('app'))$('app').classList.add('hidden');
 const btn=$('loginBtn');
 if(btn){btn.type='button';btn.addEventListener('click',e=>{e.preventDefault();login();},false)}
 const pass=$('password');
 if(pass)pass.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();login();}});
 try{
  const raw=storageGet('aurion_session_v1','');
  if(raw){
   const saved=JSON.parse(raw);
   if(saved&&saved.id){
    currentUser=saved;
    $('loginPage').classList.add('hidden');
    $('app').classList.remove('hidden');
    setHeader();renderNav();renderDashboard();showDashboard();
   }
  }
 }catch(e){try{localStorage.removeItem('aurion_session_v1')}catch(_){} console.warn('Session restore failed',e)}
});
